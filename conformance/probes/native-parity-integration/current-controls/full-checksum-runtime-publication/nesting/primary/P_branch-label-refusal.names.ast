[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>], 
              [var |-> "y", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type      |-> "labelIf",
                           test      |-> << "x", "=", "0" >>,
                           unlabThen |-> <<>>,
                           labThen   |-> <<[label |-> "B",
                                            stmts |-> <<[type |-> "assignment",
                                                         ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                                     rhs |-> << "1" >>]>>]>>]>>,
                           unlabElse |-> <<[type |-> "skip"]>>,
                           labElse   |-> <<>>]
                          >>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]