[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>], 
              [var |-> "y", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type   |-> "with", 
                           var    |-> "a",
                           eqOrIn |-> "=",
                           exp    |-> << "1" >>,
                           do     |-> <<[type   |-> "with", 
                                         var    |-> "b",
                                         eqOrIn |-> "=",
                                         exp    |-> << "a", "+", "1" >>,
                                         do     |-> <<[type |-> "assignment",
                                                       ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                                   rhs |-> << "a", "+", "b" >>]>>]>>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]