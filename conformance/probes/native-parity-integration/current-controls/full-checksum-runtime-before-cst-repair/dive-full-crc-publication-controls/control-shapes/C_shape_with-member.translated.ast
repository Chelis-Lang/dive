[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type   |-> "with", 
                           var    |-> "a",
                           eqOrIn |-> "\\in",
                           exp    |-> << "{", "0", ",", "1", "}" >>,
                           do     |-> <<[type |-> "assignment",
                                         ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                     rhs |-> << "a" >>]>>]>>]>>]>>]