  "commands": {
    "semantic": "dive analyze ROOT --library-path LIB --output json; java -Xmx2g -XX:ActiveProcessorCount=1 -DTLA-Library=LIB -cp JAR tla2sany.SANY ROOT",
    "explicit": "dive check Pastry.tla --config CFG --library-path LIB --store exact --workers 1 --compat=tlc --fp 0 --seed 0 --max-memory 2g --time-limit BUDGET --output json",
