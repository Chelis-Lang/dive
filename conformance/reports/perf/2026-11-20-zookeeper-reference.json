      "    Parameters <- BoundParameters",
      "    MaxT = 2",
      "    MaxF = 1",
      "    MaxR = 0",
      "    MaxE = 3",
      "    LOOKING = LOOKING",
      "    FOLLOWING = FOLLOWING",
      "    LEADING = LEADING",
      "    ELECTION = ELECTION",
      "    DISCOVERY = DISCOVERY",
      "    SYNCHRONIZATION = SYNCHRONIZATION",
      "    BROADCAST = BROADCAST",
      "    CEPOCH = CEPOCH",
      "    NEWEPOCH = NEWEPOCH",
      "    ACKEPOCH = ACKEPOCH",
      "    NEWLEADER = NEWLEADER",
      "    ACKLD = ACKLD",
      "    COMMITLD = COMMITLD",
      "    PROPOSE = PROPOSE",
      "    ACK = ACK",
      "    COMMIT = COMMIT",
      "    NullPoint = NullPoint",
      "INVARIANT ShouldNotBeTriggered",
      "INVARIANT Leadership1",
      "INVARIANT Leadership2",
      "INVARIANT PrefixConsistency",
      "INVARIANT Integrity",
      "INVARIANT Agreement",
      "INVARIANT TotalOrder",
      "INVARIANT LocalPrimaryOrder",
      "INVARIANT GlobalPrimaryOrder",
      "INVARIANT PrimaryIntegrity"
    ],
    "substitutions": "Replace Server with {s1, ..., sN}, MaxT, MaxF and MaxR with the recorded integer parameters. Keep MaxE=3 from the upstream example; the paper omits it. Every run retains the ten invariants, symmetry and original action bodies."
