  "methods": {
    "accounting": "Distinct counts exact configured symmetry representatives except compiled tlx, which uses fingerprints. Generated counts include Init and every enabled transition witness. Depth is BFS levels.",
    "affinity": "CPU 0 at one worker, CPUs 0-7 at eight workers, one timed process group at a time.",
    "cold": "Real public compiled invocation. Fresh scratch, no retained compiled program. Wall includes binding, emission, rustc and search. Final-cleanup cold samples were collected on the same host after the exact Core and peer series.",
    "warm": "Generate the identical worker once from the bound source and run the resulting binary at the desired width. Binding and compilation are outside the timed process.",
    "ordinary": "dive check MODULE --config CFG --compat=tlc --store exact --workers N --seed 0 --fp 0 --max-memory 24g --time-limit 1800s --output json",
    "compiled": "dive check MODULE --config CFG --strategy compiled --workers N --time-limit 30s --max-memory 24g --output json",
    "tlx": "Pin 77867a37d59525ce8866e8cce7f2dd32dc5d4d04 and the earlier packed comparison binary. tlx check MODULE -tlc -compile -config CFG -workers N; a unique cache per cold/warm pair.",
    "memory": "GNU time peak child process RSS, not sum of process-group RSS. Mapping count is sampled max per process.",
    "build": "Pinned Rust 1.99.0, shipped release profile. Generated worker uses Rust's system allocator; whole-process comparisons include that layout and implementation choice."
  },
