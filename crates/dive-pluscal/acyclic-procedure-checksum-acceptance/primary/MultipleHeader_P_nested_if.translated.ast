[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Put", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
               params |-> <<[var |-> "z", eqOrIn |-> "=", val |-> << "0" >>], 
                            [var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "P1",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "a", "+", "z" >>]>>]>>], 
                            [label |-> "P2",
                             stmts |-> <<[type |-> "return", from |-> "Put"]>>]>>], 
              [name   |-> "Get", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Put", "Get">>,
               params |-> <<[var |-> "q", eqOrIn |-> "=", val |-> << "0" >>], 
                            [var |-> "b", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "G1",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "b", "+", "q" >>]>>]>>], 
                            [label |-> "G2",
                             stmts |-> <<[type |-> "return", from |-> "Get"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type    |-> "if", 
                           test    |-> << "x", "=", "0" >>,
                           then |-> <<[type    |-> "if", 
                                       test    |-> << "x", "<", "1" >>,
                                       then |-> <<[type |-> "assignment",
                                                   ass  |-> <<[lhs |-> [var |-> "a", sub |-> <<  >>],
                                                               rhs |-> << "2" >>], 
                                                              [lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                               rhs |-> << "<<", "[", "procedure", "|->", "\"", "Put", "\"", ","
, "pc", "|->", "\"", "E", "\"", ","
, "z", "|->", "z", ","
, "a", "|->", "a", "]", ">>"
, "\\o", "stack" >>], 
                                                              [lhs |-> [var |-> "z", sub |-> <<  >>],
                                                               rhs |-> << "1" >>]>>], 
                                                  [type |-> "assignment",
                                                   ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                               rhs |-> << "\"", "P1", "\"" >>]>>]>>,
                                       else |-> <<[type |-> "assignment",
                                                   ass  |-> <<[lhs |-> [var |-> "b", sub |-> <<  >>],
                                                               rhs |-> << "4" >>], 
                                                              [lhs |-> [var |-> "q", sub |-> <<  >>],
                                                               rhs |-> << "3" >>], 
                                                              [lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                               rhs |-> << "<<", "[", "procedure", "|->", "\"", "Get", "\"", ","
, "pc", "|->", "\"", "E", "\"", ","
, "q", "|->", "q", ","
, "b", "|->", "b", "]", ">>"
, "\\o", "stack" >>]>>], 
                                                  [type |-> "assignment",
                                                   ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                               rhs |-> << "\"", "G1", "\"" >>]>>]>>]>>,
                           else |-> <<[type |-> "skip"], 
                                      [type |-> "assignment",
                                       ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                   rhs |-> << "\"", "E", "\"" >>]>>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]