[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Outer", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Inner">>,
               params |-> <<>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "O1",
                             stmts |-> <<[type     |-> "call",
                                          returnTo |-> "",
                                          to       |-> "Inner",
                                          args     |-> <<>>]>>], 
                            [label |-> "O2",
                             stmts |-> <<[type |-> "return", from |-> "Outer"]>>]>>], 
              [name   |-> "Inner", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Outer">>,
               params |-> <<>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "I1",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "x", "+", "1" >>]>>]>>], 
                            [label |-> "I2",
                             stmts |-> <<[type |-> "return", from |-> "Inner"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type     |-> "call",
                           returnTo |-> "",
                           to       |-> "Outer",
                           args     |-> <<>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]