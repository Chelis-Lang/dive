[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Outer", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
               params |-> <<[var |-> "p", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "O1",
                             stmts |-> <<[type |-> "when", 
                                          exp |-> << "pc", "=", "\"", "O1", "\"" >>], 
                                         [type   |-> "with", 
                                          var    |-> "t",
                                          eqOrIn |-> "=",
                                          exp    |-> << "p", "+", "1" >>,
                                          do     |-> <<[type |-> "assignment",
                                                        ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                                    rhs |-> << "<<", "[", "procedure", "|->", "\"", "Inner", "\"", ","
, "pc", "|->", "\"", "O2", "\"", ","
, "q", "|->", "q", "]", ">>"
, "\\o", "stack" >>], 
                                                                   [lhs |-> [var |-> "q", sub |-> <<  >>],
                                                                    rhs |-> << "t" >>]>>], 
                                                       [type |-> "assignment",
                                                        ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                    rhs |-> << "\"", "I1", "\"" >>]>>]>>]>>], 
                            [label |-> "O2",
                             stmts |-> <<[type |-> "when", 
                                          exp |-> << "pc", "=", "\"", "O2", "\"" >>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                      rhs |-> << "Head", "(", "stack", ")", ".", "pc" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "p", sub |-> <<  >>],
                                                      rhs |-> << "Head", "(", "stack", ")", ".", "p" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                      rhs |-> << "Tail", "(", "stack", ")" >>]>>]>>]>>], 
              [name   |-> "Inner", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
               params |-> <<[var |-> "q", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "I1",
                             stmts |-> <<[type |-> "when", 
                                          exp |-> << "pc", "=", "\"", "I1", "\"" >>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "q" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                      rhs |-> << "\"", "I2", "\"" >>]>>]>>], 
                            [label |-> "I2",
                             stmts |-> <<[type |-> "when", 
                                          exp |-> << "pc", "=", "\"", "I2", "\"" >>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                      rhs |-> << "Head", "(", "stack", ")", ".", "pc" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "q", sub |-> <<  >>],
                                                      rhs |-> << "Head", "(", "stack", ")", ".", "q" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                      rhs |-> << "Tail", "(", "stack", ")" >>]>>]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type |-> "when", 
                           exp |-> << "pc", "=", "\"", "L", "\"" >>], 
                          [type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                       rhs |-> << "<<", "[", "procedure", "|->", "\"", "Outer", "\"", ","
, "pc", "|->", "\"", "E", "\"", ","
, "p", "|->", "p", "]", ">>"
, "\\o", "stack" >>], 
                                      [lhs |-> [var |-> "p", sub |-> <<  >>],
                                       rhs |-> << "1" >>]>>], 
                          [type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                       rhs |-> << "\"", "O1", "\"" >>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "when", 
                           exp |-> << "pc", "=", "\"", "E", "\"" >>], 
                          [type |-> "skip"], 
                          [type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                       rhs |-> << "\"", "Done", "\"" >>]>>]>>]>>]