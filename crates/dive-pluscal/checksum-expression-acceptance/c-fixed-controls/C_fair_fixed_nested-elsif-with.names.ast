[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>], 
              [var |-> "y", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type   |-> "with", 
                           var    |-> "a",
                           eqOrIn |-> "=",
                           exp    |-> << "1" >>,
                           do     |-> <<[type   |-> "with", 
                                         var    |-> "b",
                                         eqOrIn |-> "=",
                                         exp    |-> << "2" >>,
                                         do     |-> <<[type    |-> "if", 
                                                       test    |-> << "x", "=", "0" >>,
                                                       then |-> <<[type |-> "assignment",
                                                                   ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                                               rhs |-> << "a" >>]>>]>>,
                                                       else |-> <<[type    |-> "if", 
                                                                   test    |-> << "x", "=", "1" >>,
                                                                   then |-> <<[type |-> "assignment",
                                                                               ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                                                           rhs |-> << "b" >>]>>]>>,
                                                                   else |-> <<[type |-> "skip"]>>]>>]>>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]