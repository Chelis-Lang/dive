[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>], 
              [var |-> "y", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type   |-> "with", 
                           var    |-> "a",
                           eqOrIn |-> "=",
                           exp    |-> << "1" >>,
                           do     |-> <<[type   |-> "with", 
                                         var    |-> "b",
                                         eqOrIn |-> "=",
                                         exp    |-> << "2" >>,
                                         do     |-> <<[type   |-> "with", 
                                                       var    |-> "c",
                                                       eqOrIn |-> "=",
                                                       exp    |-> << "3" >>,
                                                       do     |-> <<[type   |-> "with", 
                                                                     var    |-> "d",
                                                                     eqOrIn |-> "=",
                                                                     exp    |-> << "4" >>,
                                                                     do     |-> <<[type |-> "assignment",
                                                                                   ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                                                               rhs |-> << "a", "+", "b", "+", "c", "+", "d" >>]>>]>>]>>]>>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]