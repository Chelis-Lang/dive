[type    |-> "multiprocess", 
 name  |-> "A", 
 decls |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs  |-> <<  >>,
 prcds |-> <<[name   |-> "First", 
             minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"First">>,
              params |-> <<[var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
              decls  |-> <<>>,
              body   |-> <<[label |-> "F",
                            stmts |-> <<[type    |-> "if", 
                                         test    |-> << "a", ">", "0" >>,
                                         then |-> <<[type     |-> "callReturn",
                                                     from     |-> "First",
                                                     to       |-> "First",
                                                    args     |-> <<<< "a", "-", "1" >>>>]
                                                                 >>,
                                         else |-> <<[type |-> "assignment",
                                                     ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                                 rhs |-> << "a" >>]>>], 
                                                    [type |-> "goto",  to |-> "R"]>>]>>], 
                           [label |-> "R",
                            stmts |-> <<[type |-> "return", from |-> "First"]>>]>>]>>,
 procs |-> <<[name   |-> "Worker",
              fairness |-> "unfair", minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"First">>,
              eqOrIn |-> "=",
              id     |-> << "1" >>,
              decls  |-> <<>>,
              body   |-> <<[label |-> "L",
                            stmts |-> <<[type     |-> "call",
                                         returnTo |-> "",
                                         to       |-> "First",
                                         args     |-> <<<< "2" >>>>]>>], 
                           [label |-> "E",
                            stmts |-> <<[type |-> "skip"]>>]>>]>>]