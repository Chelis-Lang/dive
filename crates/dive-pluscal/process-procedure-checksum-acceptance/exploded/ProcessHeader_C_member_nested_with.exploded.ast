[type    |-> "multiprocess", 
 name  |-> "A", 
 decls |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs  |-> <<  >>,
 prcds |-> <<[name   |-> "First", 
             minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
              params |-> <<[var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
              decls  |-> <<>>,
              body   |-> <<[label |-> "F",
                            stmts |-> <<[type |-> "when", 
                                         exp |-> << "pc", "=", "\"", "F", "\"" >>], 
                                        [type |-> "assignment",
                                         ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                     rhs |-> << "a" >>]>>], 
                                        [type |-> "assignment",
                                         ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                     rhs |-> << "\"", "R", "\"" >>]>>]>>], 
                           [label |-> "R",
                            stmts |-> <<[type |-> "when", 
                                         exp |-> << "pc", "=", "\"", "R", "\"" >>], 
                                        [type |-> "assignment",
                                         ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                     rhs |-> << "Head", "(", "stack", ")", ".", "pc" >>]>>], 
                                        [type |-> "assignment",
                                         ass  |-> <<[lhs |-> [var |-> "a", sub |-> <<  >>],
                                                     rhs |-> << "Head", "(", "stack", ")", ".", "a" >>]>>], 
                                        [type |-> "assignment",
                                         ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                     rhs |-> << "Tail", "(", "stack", ")" >>]>>]>>]>>]>>,
 procs |-> <<[name   |-> "Worker",
              fairness |-> "unfair", minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
              eqOrIn |-> "\\in",
              id     |-> << "{", "1", ",", "2", "}" >>,
              decls  |-> <<>>,
              body   |-> <<[label |-> "L",
                            stmts |-> <<[type |-> "when", 
                                         exp |-> << "pc", "=", "\"", "L", "\"" >>], 
                                        [type   |-> "with", 
                                         var    |-> "t",
                                         eqOrIn |-> "=",
                                         exp    |-> << "2" >>,
                                         do     |-> <<[type |-> "assignment",
                                                       ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                                   rhs |-> << "<<", "[", "procedure", "|->", "\"", "First", "\"", ","
, "pc", "|->", "\"", "E", "\"", ","
, "a", "|->", "a", "]", ">>"
, "\\o", "stack" >>], 
                                                                  [lhs |-> [var |-> "a", sub |-> <<  >>],
                                                                   rhs |-> << "t" >>]>>], 
                                                      [type |-> "assignment",
                                                       ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                   rhs |-> << "\"", "F", "\"" >>]>>]>>]>>], 
                           [label |-> "E",
                            stmts |-> <<[type |-> "when", 
                                         exp |-> << "pc", "=", "\"", "E", "\"" >>], 
                                        [type |-> "skip"], 
                                        [type |-> "assignment",
                                         ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                     rhs |-> << "\"", "Done", "\"" >>]>>]>>]>>]>>]