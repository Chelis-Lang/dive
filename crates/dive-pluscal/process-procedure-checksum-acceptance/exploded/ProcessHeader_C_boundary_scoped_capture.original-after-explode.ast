[type    |-> "multiprocess", 
 name  |-> "A", 
 decls |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs  |-> <<  >>,
 prcds |-> <<[name   |-> "First", 
             minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
              params |-> <<[var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
              decls  |-> <<>>,
              body   |-> <<[label |-> "F",
                            stmts |-> <<[type |-> "assignment",
                                         ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                     rhs |-> << "a" >>]>>]>>], 
                           [label |-> "R",
                            stmts |-> <<[type |-> "return", from |-> "First"]>>]>>]>>,
 procs |-> <<[name   |-> "Worker",
              fairness |-> "unfair", minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"First">>,
              eqOrIn |-> "=",
              id     |-> << "1" >>,
              decls  |-> <<>>,
              body   |-> <<[label |-> "L",
                            stmts |-> <<[type   |-> "with", 
                                         var    |-> "a",
                                         eqOrIn |-> "=",
                                         exp    |-> << "2" >>,
                                         do     |-> <<[type |-> "assignment",
                                                       ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                                   rhs |-> << "<<", "[", "procedure", "|->", "\"", "First", "\"", ","
, "pc", "|->", "\"", "E", "\"", ","
, "a", "|->", "a", "]", ">>"
, "\\o", "stack" >>], 
                                                                  [lhs |-> [var |-> "a", sub |-> <<  >>],
                                                                   rhs |-> << "a" >>]>>], 
                                                      [type |-> "assignment",
                                                       ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                   rhs |-> << "\"", "F", "\"" >>]>>]>>]>>], 
                           [label |-> "E",
                            stmts |-> <<[type |-> "skip"]>>]>>]>>]