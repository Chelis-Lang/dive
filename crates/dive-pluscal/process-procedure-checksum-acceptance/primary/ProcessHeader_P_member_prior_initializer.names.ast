[type    |-> "multiprocess", 
 name  |-> "A", 
 decls |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs  |-> <<  >>,
 prcds |-> <<[name   |-> "First", 
             minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
              params |-> <<[var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
              decls  |-> <<[var |-> "u", eqOrIn |-> "=", val |-> << "a" >>], 
                           [var |-> "v", eqOrIn |-> "=", val |-> << "u", "+", "1" >>]>>,
              body   |-> <<[label |-> "F",
                            stmts |-> <<[type |-> "assignment",
                                         ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                     rhs |-> << "v" >>]>>]>>], 
                           [label |-> "R",
                            stmts |-> <<[type |-> "return", from |-> "First"]>>]>>]>>,
 procs |-> <<[name   |-> "Worker",
              fairness |-> "unfair", minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"First">>,
              eqOrIn |-> "\\in",
              id     |-> << "{", "1", ",", "2", "}" >>,
              decls  |-> <<>>,
              body   |-> <<[label |-> "L",
                            stmts |-> <<[type     |-> "call",
                                         returnTo |-> "",
                                         to       |-> "First",
                                         args     |-> <<<< "2" >>>>]>>], 
                           [label |-> "E",
                            stmts |-> <<[type |-> "skip"]>>]>>]>>]