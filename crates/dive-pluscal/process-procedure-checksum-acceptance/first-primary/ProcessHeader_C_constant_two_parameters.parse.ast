[type    |-> "multiprocess", 
 name  |-> "A", 
 decls |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs  |-> <<  >>,
 prcds |-> <<[name   |-> "First", 
             minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
              params |-> <<[var |-> "a", eqOrIn |-> "=", val |-> << "0" >>], 
                           [var |-> "b", eqOrIn |-> "=", val |-> << "0" >>]>>,
              decls  |-> <<>>,
              body   |-> <<[label |-> "F",
                            stmts |-> <<[type |-> "assignment",
                                         ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                     rhs |-> << "a", "+", "b" >>]>>]>>], 
                           [label |-> "R",
                            stmts |-> <<[type |-> "return", from |-> "First"]>>]>>]>>,
 procs |-> <<[name   |-> "Worker",
              fairness |-> "unfair", minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"First">>,
              eqOrIn |-> "=",
              id     |-> << "1" >>,
              decls  |-> <<>>,
              body   |-> <<[label |-> "L",
                            stmts |-> <<[type     |-> "call",
                                         returnTo |-> "",
                                         to       |-> "First",
                                         args     |-> <<<< "2" >>, 
                                                        << "3" >>>>]>>], 
                           [label |-> "E",
                            stmts |-> <<[type |-> "skip"]>>]>>]>>]