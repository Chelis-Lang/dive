[type    |-> "multiprocess", 
 name  |-> "A", 
 decls |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>], 
             [var |-> "y", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs  |-> << "F", "==", "(col5) /\\", "x", "=", "0"
, "(col4) /\\", "y", "=", "0" >>,
 prcds |-> <<>>,
 procs |-> <<[name   |-> "P",
              fairness |-> "unfair", minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
              eqOrIn |-> "\\in",
              id     |-> << "{", "1", ",", "2", "}" >>,
              decls  |-> <<[var |-> "z", eqOrIn |-> "=", val |-> << "0" >>]>>,
              body   |-> <<[label |-> "L",
                            stmts |-> <<[type    |-> "if", 
                                         test    |-> << "F" >>,
                                         then |-> <<[type |-> "assignment",
                                                     ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                                 rhs |-> << "1" >>]>>]>>,
                                         else |-> <<>>]>>]>>]>>]