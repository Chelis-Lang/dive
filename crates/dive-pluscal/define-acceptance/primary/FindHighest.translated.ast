[type     |-> "uniprocess", 
 name  |-> "Highest", 
 decls  |-> <<[var |-> "f", eqOrIn |-> "\\in", val |-> << "Seq", "(", "Nat", ")" >>], 
              [var |-> "h", eqOrIn |-> "=", val |-> << "-", "1" >>], 
              [var |-> "i", eqOrIn |-> "=", val |-> << "1" >>]>>,
 defs   |-> << "max", "(", "a", ",", "b", ")", "==", "IF", "a", ">=", "b", "THEN", "a", "ELSE", "b" >>,
 prcds  |-> <<>>,
 body  |-> <<[label |-> "lb",
              stmts |-> <<[type    |-> "while", 
                           test    |-> << "i", "<=", "Len", "(", "f", ")" >>,
                           labDo   |-> <<>>,
                           unlabDo |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "h", sub |-> <<  >>],
                                                      rhs |-> << "max", "(", "h", ",", "f", "[", "i", "]", ")" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "i", sub |-> <<  >>],
                                                      rhs |-> << "i", "+", "1" >>]>>]>>]>>]>>]