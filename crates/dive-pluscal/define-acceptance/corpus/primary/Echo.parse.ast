[type    |-> "multiprocess", 
 name  |-> "Echo", 
 decls |-> <<[var |-> "inbox", eqOrIn |-> "=", val |-> << "[", "n", "\\in", "Node", "|->", "{", "}", "]" >>]>>,
 defs  |-> << "send", "(", "net", ",", "p", ",", "q", ",", "knd", ")", "==", "[", "net", "EXCEPT", "!", "[", "q", "]", "=", "@", "\\cup", "{", "[", "kind", "|->", "knd", ",", "sndr", "|->", "p", "]", "}", "]"

, "receive", "(", "net", ",", "p", ",", "msg", ")", "==", "[", "net", "EXCEPT", "!", "[", "p", "]", "=", "@", "\\", "{", "msg", "}", "]"

, "multicast", "(", "net", ",", "p", ",", "dest", ",", "knd", ")", "=="
, "[", "m", "\\in", "Node", "|->", "IF", "m", "\\in", "dest", "THEN", "net", "[", "m", "]", "\\cup", "{", "[", "kind", "|->", "knd", ",", "sndr", "|->", "p", "]", "}"
, "ELSE", "net", "[", "m", "]", "]" >>,
 prcds |-> <<>>,
 procs |-> <<[name   |-> "node",
              fairness |-> "unfair", minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
              eqOrIn |-> "\\in",
              id     |-> << "Node" >>,
              decls  |-> <<[var |-> "parent", eqOrIn |-> "=", val |-> << "NoNode" >>], 
                           [var |-> "children", eqOrIn |-> "=", val |-> << "{", "}" >>], 
                           [var |-> "rcvd", eqOrIn |-> "=", val |-> << "0" >>], 
                           [var |-> "nbrs", eqOrIn |-> "=", val |-> << "neighbors", "(", "self", ")" >>]>>,
              body   |-> <<[label |-> "n0",
                            stmts |-> <<[type    |-> "if", 
                                         test    |-> << "self", "=", "initiator" >>,
                                         then |-> <<[type |-> "assignment",
                                                     ass  |-> <<[lhs |-> [var |-> "inbox", sub |-> <<  >>],
                                                                 rhs |-> << "multicast", "(", "inbox", ",", "self", ",", "nbrs", ",", "\"", "m", "\"", ")" >>]>>]>>,
                                         else |-> <<>>]>>], 
                           [label |-> "n1",
                            stmts |-> <<[type    |-> "while", 
                                         test    |-> << "rcvd", "<", "Cardinality", "(", "nbrs", ")" >>,
                                         labDo   |-> <<>>,
                                         unlabDo |-> <<[type   |-> "with", 
                                                        var    |-> "msg",
                                                        eqOrIn |-> "\\in",
                                                        exp    |-> << "inbox", "[", "self", "]" >>,
                                                        do     |-> <<[type   |-> "with", 
                                                                      var    |-> "net",
                                                                      eqOrIn |-> "=",
                                                                      exp    |-> << "receive", "(", "inbox", ",", "self", ",", "msg", ")" >>,
                                                                      do     |-> <<[type |-> "assignment",
                                                                                    ass  |-> <<[lhs |-> [var |-> "rcvd", sub |-> <<  >>],
                                                                                                rhs |-> << "rcvd", "+", "1" >>]>>], 
                                                                                   [type    |-> "if", 
                                                                                    test    |-> << "self", "#", "initiator", "(col17) /\\", "rcvd", "=", "1" >>,
                                                                                    then |-> <<[type |-> "assert", 
                                                                                                exp |-> << "(", "msg", ".", "kind", "=", "\"", "m", "\"", ")" >>], 
                                                                                               [type |-> "assignment",
                                                                                                ass  |-> <<[lhs |-> [var |-> "parent", sub |-> <<  >>],
                                                                                                            rhs |-> << "msg", ".", "sndr" >>]>>], 
                                                                                               [type |-> "assignment",
                                                                                                ass  |-> <<[lhs |-> [var |-> "inbox", sub |-> <<  >>],
                                                                                                            rhs |-> << "multicast", "(", "net", ",", "self", ",", "nbrs", "\\", "{", "msg", ".", "sndr", "}", ",", "\"", "m", "\"", ")" >>]>>]>>,
                                                                                    else |-> <<[type |-> "assignment",
                                                                                                ass  |-> <<[lhs |-> [var |-> "inbox", sub |-> <<  >>],
                                                                                                            rhs |-> << "net" >>]>>]>>], 
                                                                                   [type    |-> "if", 
                                                                                    test    |-> << "msg", ".", "kind", "=", "\"", "c", "\"" >>,
                                                                                    then |-> <<[type |-> "assignment",
                                                                                                ass  |-> <<[lhs |-> [var |-> "children", sub |-> <<  >>],
                                                                                                            rhs |-> << "children", "\\cup", "{", "msg", ".", "sndr", "}" >>]>>]>>,
                                                                                    else |-> <<>>]>>]>>]>>]>>], 
                           [label |-> "n2",
                            stmts |-> <<[type    |-> "if", 
                                         test    |-> << "self", "#", "initiator" >>,
                                         then |-> <<[type |-> "assert", 
                                                     exp |-> << "(", "parent", "\\in", "nbrs", ")" >>], 
                                                    [type |-> "assignment",
                                                     ass  |-> <<[lhs |-> [var |-> "inbox", sub |-> <<  >>],
                                                                 rhs |-> << "send", "(", "inbox", ",", "self", ",", "parent", ",", "\"", "c", "\"", ")" >>]>>]>>,
                                         else |-> <<>>]>>]>>]>>]