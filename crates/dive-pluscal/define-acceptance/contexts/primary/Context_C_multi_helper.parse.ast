[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>], 
              [var |-> "y", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> << "F", "(", "a", ")", "==", "a", "+", "1"
, "G", "(", "a", ")", "==", "F", "(", "a", ")", "+", "1" >>,
 prcds  |-> <<>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                       rhs |-> << "G", "(", "1", ")" >>]>>]>>]>>]