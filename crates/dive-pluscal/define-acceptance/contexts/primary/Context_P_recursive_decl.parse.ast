[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>], 
              [var |-> "y", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> << "RECURSIVE", "F", "(", "_", ")"
, "F", "(", "a", ")", "==", "IF", "a", "=", "0", "THEN", "0", "ELSE", "F", "(", "a", "-", "1", ")" >>,
 prcds  |-> <<>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                       rhs |-> << "F", "(", "1", ")" >>]>>]>>]>>]