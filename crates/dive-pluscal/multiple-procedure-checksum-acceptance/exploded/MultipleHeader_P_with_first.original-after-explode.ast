[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Put", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
               params |-> <<[var |-> "z", eqOrIn |-> "=", val |-> << "0" >>], 
                            [var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "P1",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "a", "+", "z" >>]>>]>>], 
                            [label |-> "P2",
                             stmts |-> <<[type |-> "return", from |-> "Put"]>>]>>], 
              [name   |-> "Get", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Put">>,
               params |-> <<[var |-> "q", eqOrIn |-> "=", val |-> << "0" >>], 
                            [var |-> "b", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "G1",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "b", "+", "q" >>]>>]>>], 
                            [label |-> "G2",
                             stmts |-> <<[type |-> "return", from |-> "Get"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type   |-> "with", 
                           var    |-> "t",
                           eqOrIn |-> "=",
                           exp    |-> << "2" >>,
                           do     |-> <<[type |-> "assignment",
                                         ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                     rhs |-> << "<<", "[", "procedure", "|->", "\"", "Put", "\"", ","
, "pc", "|->", "\"", "E", "\"", ","
, "z", "|->", "z", ","
, "a", "|->", "a", "]", ">>"
, "\\o", "stack" >>], 
                                                    [lhs |-> [var |-> "z", sub |-> <<  >>],
                                                     rhs |-> << "t" >>], 
                                                    [lhs |-> [var |-> "a", sub |-> <<  >>],
                                                     rhs |-> << "1" >>]>>], 
                                        [type |-> "assignment",
                                         ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                     rhs |-> << "\"", "P1", "\"" >>]>>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]