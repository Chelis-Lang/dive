[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Put", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
               params |-> <<[var |-> "z", eqOrIn |-> "=", val |-> << "0" >>], 
                            [var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "P1",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "a", "+", "z" >>]>>]>>], 
                            [label |-> "P2",
                             stmts |-> <<[type |-> "return", from |-> "Put"]>>]>>], 
              [name   |-> "Get", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Put", "Get">>,
               params |-> <<[var |-> "q", eqOrIn |-> "=", val |-> << "0" >>], 
                            [var |-> "b", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "G1",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "b", "+", "q" >>]>>]>>], 
                            [label |-> "G2",
                             stmts |-> <<[type |-> "return", from |-> "Get"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type    |-> "if", 
                           test    |-> << "x", "=", "0" >>,
                           then |-> <<[type    |-> "if", 
                                       test    |-> << "x", "<", "1" >>,
                                       then |-> <<[type     |-> "callGoto",
                                                   after    |-> "E",
                                                   to       |-> "Put",
                                                  args     |-> <<<< "1" >>, 
                                                                 << "2" >>>>]
                                                               >>,
                                       else |-> <<[type     |-> "callGoto",
                                                   after    |-> "E",
                                                   to       |-> "Get",
                                                  args     |-> <<<< "3" >>, 
                                                                 << "4" >>>>]
                                                               >>]>>,
                           else |-> <<[type |-> "skip"]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]