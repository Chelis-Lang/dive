[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Put", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
               params |-> <<[var |-> "z", eqOrIn |-> "=", val |-> << "0" >>], 
                            [var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "P1",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "a", "+", "z" >>]>>]>>], 
                            [label |-> "P2",
                             stmts |-> <<[type |-> "return", from |-> "Put"]>>]>>], 
              [name   |-> "Get", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Put", "Get">>,
               params |-> <<[var |-> "q", eqOrIn |-> "=", val |-> << "0" >>], 
                            [var |-> "b", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "G1",
                             stmts |-> <<[type |-> "either", 
                                          ors  |-> << <<[type |-> "return", from |-> "Get"]>>, 
                                                      <<[type |-> "assignment",
                                                         ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                                     rhs |-> << "b" >>]>>], 
                                                        [type |-> "return", from |-> "Get"]>> >>]>>], 
                            [label |-> "G2",
                             stmts |-> <<[type |-> "skip"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type     |-> "call",
                           returnTo |-> "",
                           to       |-> "Put",
                           args     |-> <<<< "1" >>, 
                                          << "2" >>>>]>>], 
             [label |-> "M",
              stmts |-> <<[type     |-> "call",
                           returnTo |-> "",
                           to       |-> "Get",
                           args     |-> <<<< "3" >>, 
                                          << "4" >>>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]