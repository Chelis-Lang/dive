[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>], 
              [var |-> "y", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> << "LOCAL", "G", "(", "a", ")", "==", "a", "+", "1", "F", "[", "a", "\\in", "{", "1", ",", "2", "}", "]", "==", "G", "(", "a", ")" >>,
 prcds  |-> <<>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "y", sub |-> <<  >>],
                                       rhs |-> << "F", "[", "1", "]" >>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]