[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>], 
              [var |-> "y", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> << "F", "[", "a", "\\in", "{", "1", ",", "2", "}", "]", "==", "IF", "\\E", "q", "\\in", "{", "1", ",", "2", "}", ":", "q", "=", "a", "THEN", "a", "ELSE", "0" >>,
 prcds  |-> <<>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "y", sub |-> <<  >>],
                                       rhs |-> << "F", "[", "1", "]" >>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]