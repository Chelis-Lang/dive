[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>], 
              [var |-> "y", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> << "F", "[", "a", "\\in", "{", "1", ",", "2", "}", "]", "==", "x", "+", "a" >>,
 prcds  |-> <<>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                       rhs |-> << "1" >>]>>], 
                          [type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "y", sub |-> <<  >>],
                                       rhs |-> << "F", "[", "1", "]" >>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]