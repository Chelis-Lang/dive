[type    |-> "multiprocess", 
 name  |-> "A", 
 decls |-> <<[var |-> "g", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs  |-> <<  >>,
 prcds |-> <<>>,
 procs |-> <<[name   |-> "P",
              fairness |-> "unfair", minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
              eqOrIn |-> "=",
              id     |-> << "1" >>,
              decls  |-> <<>>,
              body   |-> <<[label |-> "L",
                            stmts |-> <<[type |-> "assignment",
                                         ass  |-> <<[lhs |-> [var |-> "g", sub |-> <<  >>],
                                                     rhs |-> << "g", "+", "1" >>]>>]>>], 
                           [label |-> "E",
                            stmts |-> <<[type |-> "skip"]>>]>>], 
             [name   |-> "Q",
              fairness |-> "unfair", minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
              eqOrIn |-> "\\in",
              id     |-> << "{", "2", ",", "3", "}" >>,
              decls  |-> <<[var |-> "z", eqOrIn |-> "=", val |-> << "0" >>]>>,
              body   |-> <<[label |-> "M",
                            stmts |-> <<[type |-> "assignment",
                                         ass  |-> <<[lhs |-> [var |-> "z", sub |-> <<  >>],
                                                     rhs |-> << "1" >>]>>]>>], 
                           [label |-> "F",
                            stmts |-> <<[type |-> "assignment",
                                         ass  |-> <<[lhs |-> [var |-> "g", sub |-> <<  >>],
                                                     rhs |-> << "z" >>]>>]>>]>>]>>]