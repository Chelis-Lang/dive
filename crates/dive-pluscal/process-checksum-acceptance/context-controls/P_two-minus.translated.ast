[type    |-> "multiprocess", 
 name  |-> "A", 
 decls |-> <<[var |-> "g", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs  |-> <<  >>,
 prcds |-> <<>>,
 procs |-> <<[name   |-> "P",
              fairness |-> "sf", minusLabels |-> <<"L", "M">>, plusLabels |-><<>>, proceduresCalled |-><<>>,
              eqOrIn |-> "=",
              id     |-> << "1" >>,
              decls  |-> <<>>,
              body   |-> <<[label |-> "L",
                            stmts |-> <<[type |-> "assignment",
                                         ass  |-> <<[lhs |-> [var |-> "g", sub |-> <<  >>],
                                                     rhs |-> << "1" >>]>>]>>], 
                           [label |-> "M",
                            stmts |-> <<[type |-> "assignment",
                                         ass  |-> <<[lhs |-> [var |-> "g", sub |-> <<  >>],
                                                     rhs |-> << "2" >>]>>]>>], 
                           [label |-> "E",
                            stmts |-> <<[type |-> "skip"]>>]>>]>>]