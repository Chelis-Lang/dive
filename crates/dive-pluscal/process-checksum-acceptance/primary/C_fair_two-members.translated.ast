[type    |-> "multiprocess", 
 name  |-> "A", 
 decls |-> <<[var |-> "g", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs  |-> <<  >>,
 prcds |-> <<>>,
 procs |-> <<[name   |-> "P",
              fairness |-> "unfair", minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
              eqOrIn |-> "\\in",
              id     |-> << "{", "1", ",", "2", "}" >>,
              decls  |-> <<>>,
              body   |-> <<[label |-> "L",
                            stmts |-> <<[type |-> "assignment",
                                         ass  |-> <<[lhs |-> [var |-> "g", sub |-> <<  >>],
                                                     rhs |-> << "g", "+", "1" >>]>>]>>], 
                           [label |-> "E",
                            stmts |-> <<[type |-> "skip"]>>]>>], 
             [name   |-> "Q",
              fairness |-> "wf", minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
              eqOrIn |-> "\\in",
              id     |-> << "{", "3", ",", "4", "}" >>,
              decls  |-> <<>>,
              body   |-> <<[label |-> "M",
                            stmts |-> <<[type |-> "assignment",
                                         ass  |-> <<[lhs |-> [var |-> "g", sub |-> <<  >>],
                                                     rhs |-> << "g", "+", "1" >>]>>]>>], 
                           [label |-> "F",
                            stmts |-> <<[type |-> "skip"]>>]>>]>>]