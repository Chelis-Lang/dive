[type    |-> "multiprocess", 
 name  |-> "A", 
 decls |-> <<[var |-> "g", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs  |-> <<  >>,
 prcds |-> <<>>,
 procs |-> <<[name   |-> "P",
              fairness |-> "unfair", minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
              eqOrIn |-> "=",
              id     |-> << "1" >>,
              decls  |-> <<>>,
              body   |-> <<[label |-> "L",
                            stmts |-> <<[type    |-> "if", 
                                         test    |-> << "g", "=", "0" >>,
                                         then |-> <<[type |-> "assignment",
                                                     ass  |-> <<[lhs |-> [var |-> "g", sub |-> <<  >>],
                                                                 rhs |-> << "1" >>]>>]>>,
                                         else |-> <<[type |-> "assignment",
                                                     ass  |-> <<[lhs |-> [var |-> "g", sub |-> <<  >>],
                                                                 rhs |-> << "2" >>]>>]>>]>>], 
                           [label |-> "E",
                            stmts |-> <<[type |-> "skip"]>>]>>]>>]