[type    |-> "multiprocess", 
 name  |-> "A", 
 decls |-> <<[var |-> "g", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs  |-> <<  >>,
 prcds |-> <<>>,
 procs |-> <<[name   |-> "P",
              fairness |-> "unfair", minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
              eqOrIn |-> "=",
              id     |-> << "1" >>,
              decls  |-> <<>>,
              body   |-> <<[label |-> "L",
                            stmts |-> <<[type    |-> "while", 
                                         test    |-> << "g", "<", "2" >>,
                                         labDo   |-> <<>>,
                                         unlabDo |-> <<[type |-> "assignment",
                                                        ass  |-> <<[lhs |-> [var |-> "g", sub |-> <<  >>],
                                                                    rhs |-> << "g", "+", "1" >>]>>]>>]>>], 
                           [label |-> "E",
                            stmts |-> <<[type |-> "skip"]>>]>>]>>]