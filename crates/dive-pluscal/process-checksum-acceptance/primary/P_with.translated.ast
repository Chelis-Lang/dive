[type    |-> "multiprocess", 
 name  |-> "A", 
 decls |-> <<[var |-> "g", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs  |-> <<  >>,
 prcds |-> <<>>,
 procs |-> <<[name   |-> "P",
              fairness |-> "unfair", minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
              eqOrIn |-> "=",
              id     |-> << "1" >>,
              decls  |-> <<>>,
              body   |-> <<[label |-> "L",
                            stmts |-> <<[type   |-> "with", 
                                         var    |-> "a",
                                         eqOrIn |-> "\\in",
                                         exp    |-> << "{", "1", ",", "2", "}" >>,
                                         do     |-> <<[type |-> "assignment",
                                                       ass  |-> <<[lhs |-> [var |-> "g", sub |-> <<  >>],
                                                                   rhs |-> << "a" >>]>>]>>]>>], 
                           [label |-> "E",
                            stmts |-> <<[type |-> "skip"]>>]>>]>>]