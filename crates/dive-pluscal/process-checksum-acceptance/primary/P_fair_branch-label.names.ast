[type    |-> "multiprocess", 
 name  |-> "A", 
 decls |-> <<[var |-> "g", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs  |-> <<  >>,
 prcds |-> <<>>,
 procs |-> <<[name   |-> "P",
              fairness |-> "unfair", minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
              eqOrIn |-> "=",
              id     |-> << "1" >>,
              decls  |-> <<>>,
              body   |-> <<[label |-> "L",
                            stmts |-> <<[type      |-> "labelIf",
                                         test      |-> << "g", "=", "0" >>,
                                         unlabThen |-> <<>>,
                                         labThen   |-> <<[label |-> "M",
                                                          stmts |-> <<[type |-> "assignment",
                                                                       ass  |-> <<[lhs |-> [var |-> "g", sub |-> <<  >>],
                                                                                   rhs |-> << "1" >>]>>]>>]>>,
                                         unlabElse |-> <<[type |-> "assignment",
                                                          ass  |-> <<[lhs |-> [var |-> "g", sub |-> <<  >>],
                                                                      rhs |-> << "2" >>]>>]>>,
                                         labElse   |-> <<>>]
                                        >>], 
                           [label |-> "E",
                            stmts |-> <<[type |-> "skip"]>>]>>]>>]