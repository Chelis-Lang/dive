[type    |-> "multiprocess", 
 name  |-> "A", 
 decls |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>], 
             [var |-> "y", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs  |-> <<  >>,
 prcds |-> <<>>,
 procs |-> <<[name   |-> "P",
              fairness |-> "unfair", minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
              eqOrIn |-> "=",
              id     |-> << "1" >>,
              decls  |-> <<[var |-> "z", eqOrIn |-> "=", val |-> << "0" >>]>>,
              body   |-> <<[label |-> "L",
                            stmts |-> <<[type |-> "goto",  to |-> "F"]>>], 
                           [label |-> "E",
                            stmts |-> <<[type |-> "skip"]>>]>>], 
             [name   |-> "Q",
              fairness |-> "unfair", minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
              eqOrIn |-> "\\in",
              id     |-> << "{", "2", ",", "3", "}" >>,
              decls  |-> <<[var |-> "w", eqOrIn |-> "=", val |-> << "0" >>]>>,
              body   |-> <<[label |-> "M",
                            stmts |-> <<[type |-> "goto",  to |-> "F"]>>], 
                           [label |-> "F",
                            stmts |-> <<[type |-> "skip"]>>]>>]>>]