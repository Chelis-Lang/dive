[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>], 
              [var |-> "y", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type    |-> "if", 
                           test    |-> << "1", ">", "0" >>,
                           then |-> <<[type |-> "assignment",
                                       ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                   rhs |-> << "1" >>]>>]>>,
                           else |-> <<[type |-> "assignment",
                                       ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                   rhs |-> << "0" >>]>>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]