[type    |-> "multiprocess", 
 name  |-> "Barriers", 
 decls |-> <<[var |-> "lock", eqOrIn |-> "=", val |-> << "1" >>], 
             [var |-> "gate_1", eqOrIn |-> "=", val |-> << "0" >>], 
             [var |-> "gate_2", eqOrIn |-> "=", val |-> << "0" >>], 
             [var |-> "rdv", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs  |-> <<  >>,
 prcds |-> <<>>,
 procs |-> <<[name   |-> "proc",
              fairness |-> "unfair", minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
              eqOrIn |-> "\\in",
              id     |-> << "1", "..", "N" >>,
              decls  |-> <<>>,
              body   |-> <<[label |-> "a0",
                            stmts |-> <<[type    |-> "while", 
                                         test    |-> << "TRUE" >>,
                                         labDo   |-> <<[label |-> "a1",
                                                        stmts |-> <<[type |-> "when", 
                                                                     exp |-> << "lock", "=", "1" >>], 
                                                                    [type |-> "assignment",
                                                                     ass  |-> <<[lhs |-> [var |-> "lock", sub |-> <<  >>],
                                                                                 rhs |-> << "0" >>]>>]>>], 
                                                       [label |-> "a2",
                                                        stmts |-> <<[type |-> "assignment",
                                                                     ass  |-> <<[lhs |-> [var |-> "rdv", sub |-> <<  >>],
                                                                                 rhs |-> << "rdv", "+", "1" >>]>>]>>], 
                                                       [label |-> "a3",
                                                        stmts |-> <<[type      |-> "labelIf",
                                                                     test      |-> << "rdv", "=", "N" >>,
                                                                     unlabThen |-> <<>>,
                                                                     labThen   |-> <<[label |-> "a4",
                                                                                      stmts |-> <<[type |-> "assignment",
                                                                                                   ass  |-> <<[lhs |-> [var |-> "gate_1", sub |-> <<  >>],
                                                                                                               rhs |-> << "gate_1", "+", "N" >>]>>]>>]>>,
                                                                     unlabElse |-> <<>>,
                                                                     labElse   |-> <<>>]
                                                                    >>], 
                                                       [label |-> "a5",
                                                        stmts |-> <<[type |-> "assignment",
                                                                     ass  |-> <<[lhs |-> [var |-> "lock", sub |-> <<  >>],
                                                                                 rhs |-> << "1" >>]>>]>>], 
                                                       [label |-> "a6",
                                                        stmts |-> <<[type |-> "when", 
                                                                     exp |-> << "gate_1", ">", "0" >>], 
                                                                    [type |-> "assignment",
                                                                     ass  |-> <<[lhs |-> [var |-> "gate_1", sub |-> <<  >>],
                                                                                 rhs |-> << "gate_1", "-", "1" >>]>>]>>], 
                                                       [label |-> "a7",
                                                        stmts |-> <<[type |-> "when", 
                                                                     exp |-> << "lock", "=", "1" >>], 
                                                                    [type |-> "assignment",
                                                                     ass  |-> <<[lhs |-> [var |-> "lock", sub |-> <<  >>],
                                                                                 rhs |-> << "0" >>]>>]>>], 
                                                       [label |-> "a8",
                                                        stmts |-> <<[type |-> "assignment",
                                                                     ass  |-> <<[lhs |-> [var |-> "rdv", sub |-> <<  >>],
                                                                                 rhs |-> << "rdv", "-", "1" >>]>>]>>], 
                                                       [label |-> "a9",
                                                        stmts |-> <<[type      |-> "labelIf",
                                                                     test      |-> << "rdv", "=", "0" >>,
                                                                     unlabThen |-> <<>>,
                                                                     labThen   |-> <<[label |-> "a10",
                                                                                      stmts |-> <<[type |-> "assignment",
                                                                                                   ass  |-> <<[lhs |-> [var |-> "gate_2", sub |-> <<  >>],
                                                                                                               rhs |-> << "gate_2", "+", "N" >>]>>]>>]>>,
                                                                     unlabElse |-> <<>>,
                                                                     labElse   |-> <<>>]
                                                                    >>], 
                                                       [label |-> "a11",
                                                        stmts |-> <<[type |-> "assignment",
                                                                     ass  |-> <<[lhs |-> [var |-> "lock", sub |-> <<  >>],
                                                                                 rhs |-> << "1" >>]>>]>>], 
                                                       [label |-> "a12",
                                                        stmts |-> <<[type |-> "when", 
                                                                     exp |-> << "gate_2", ">", "0" >>], 
                                                                    [type |-> "assignment",
                                                                     ass  |-> <<[lhs |-> [var |-> "gate_2", sub |-> <<  >>],
                                                                                 rhs |-> << "gate_2", "-", "1" >>]>>]>>]>>,
                                         unlabDo |-> <<[type |-> "skip"]>>]>>]>>]>>]