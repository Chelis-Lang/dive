[type    |-> "multiprocess", 
 name  |-> "Lock", 
 decls |-> <<[var |-> "lock", eqOrIn |-> "=", val |-> << "1" >>]>>,
 defs  |-> <<  >>,
 prcds |-> <<>>,
 procs |-> <<[name   |-> "proc",
              fairness |-> "unfair", minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
              eqOrIn |-> "\\in",
              id     |-> << "1", "..", "2" >>,
              decls  |-> <<>>,
              body   |-> <<[label |-> "l0",
                            stmts |-> <<[type    |-> "while", 
                                         test    |-> << "TRUE" >>,
                                         labDo   |-> <<[label |-> "l1",
                                                        stmts |-> <<[type |-> "when", 
                                                                     exp |-> << "lock", "=", "1" >>], 
                                                                    [type |-> "assignment",
                                                                     ass  |-> <<[lhs |-> [var |-> "lock", sub |-> <<  >>],
                                                                                 rhs |-> << "0" >>]>>]>>], 
                                                       [label |-> "cs",
                                                        stmts |-> <<[type |-> "skip"]>>], 
                                                       [label |-> "l2",
                                                        stmts |-> <<[type |-> "assignment",
                                                                     ass  |-> <<[lhs |-> [var |-> "lock", sub |-> <<  >>],
                                                                                 rhs |-> << "1" >>]>>]>>]>>,
                                         unlabDo |-> <<[type |-> "skip"]>>]>>]>>]>>]