[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "[", "i", "\\in", "1", "..", "2", "|->", "0", "]" >>], 
              [var |-> "y", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "x", sub |-> << "[", "1", "]" >>],
                                       rhs |-> << "2" >>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]