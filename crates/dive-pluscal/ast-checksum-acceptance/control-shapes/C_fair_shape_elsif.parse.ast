[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type    |-> "if", 
                           test    |-> << "x", "=", "0" >>,
                           then |-> <<[type |-> "assignment",
                                       ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                   rhs |-> << "1" >>]>>]>>,
                           else |-> <<[type    |-> "if", 
                                       test    |-> << "x", "=", "1" >>,
                                       then |-> <<[type |-> "assignment",
                                                   ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                               rhs |-> << "2" >>]>>]>>,
                                       else |-> <<[type |-> "skip"]>>]>>]>>]>>]