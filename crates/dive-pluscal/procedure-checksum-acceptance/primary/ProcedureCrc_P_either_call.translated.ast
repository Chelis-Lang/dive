[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Put", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Put">>,
               params |-> <<[var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "P",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "a" >>]>>]>>], 
                            [label |-> "R",
                             stmts |-> <<[type |-> "return", from |-> "Put"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type |-> "either", 
                           ors  |-> << <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "a", sub |-> <<  >>],
                                                      rhs |-> << "2" >>], 
                                                     [lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                      rhs |-> << "<<", "[", "procedure", "|->", "\"", "Put", "\"", ","
, "pc", "|->", "\"", "E", "\"", ","
, "a", "|->", "a", "]", ">>"
, "\\o", "stack" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                      rhs |-> << "\"", "P", "\"" >>]>>]>>, 
                                       <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "a", sub |-> <<  >>],
                                                      rhs |-> << "3" >>], 
                                                     [lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                      rhs |-> << "<<", "[", "procedure", "|->", "\"", "Put", "\"", ","
, "pc", "|->", "\"", "E", "\"", ","
, "a", "|->", "a", "]", ">>"
, "\\o", "stack" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                      rhs |-> << "\"", "P", "\"" >>]>>]>> >>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]