[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Put", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Put">>,
               params |-> <<[var |-> "z", eqOrIn |-> "=", val |-> << "0" >>], 
                            [var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "P",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "z", "+", "a" >>]>>]>>], 
                            [label |-> "R",
                             stmts |-> <<[type |-> "return", from |-> "Put"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type    |-> "while", 
                           test    |-> << "(", "TRUE", ")" >>,
                           labDo   |-> <<>>,
                           unlabDo |-> <<[type |-> "skip"]>>], 
                          [type    |-> "if", 
                           test    |-> << "TRUE" >>,
                           then |-> <<[type |-> "assignment",
                                       ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                   rhs |-> << "<<", "[", "procedure", "|->", "\"", "Put", "\"", ","
, "pc", "|->", "\"", "E", "\"", ","
, "z", "|->", "z", ","
, "a", "|->", "a", "]", ">>"
, "\\o", "stack" >>], 
                                                  [lhs |-> [var |-> "z", sub |-> <<  >>],
                                                   rhs |-> << "1" >>], 
                                                  [lhs |-> [var |-> "a", sub |-> <<  >>],
                                                   rhs |-> << "2" >>]>>], 
                                      [type |-> "assignment",
                                       ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                   rhs |-> << "\"", "P", "\"" >>]>>]>>,
                           else |-> <<[type |-> "skip"], 
                                      [type |-> "assignment",
                                       ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                   rhs |-> << "\"", "E", "\"" >>]>>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]