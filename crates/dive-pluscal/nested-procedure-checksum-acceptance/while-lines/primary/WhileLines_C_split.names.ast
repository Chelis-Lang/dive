[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Put", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Put">>,
               params |-> <<[var |-> "z", eqOrIn |-> "=", val |-> << "0" >>], 
                            [var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "P",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "z", "+", "a" >>]>>]>>], 
                            [label |-> "R",
                             stmts |-> <<[type |-> "return", from |-> "Put"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type    |-> "while", 
                           test    |-> << "("
, "TRUE"
, ")" >>,
                           labDo   |-> <<>>,
                           unlabDo |-> <<[type |-> "skip"]>>], 
                          [type    |-> "if", 
                           test    |-> << "TRUE" >>,
                           then |-> <<[type     |-> "callGoto",
                                       after    |-> "E",
                                       to       |-> "Put",
                                      args     |-> <<<< "1" >>, 
                                                     << "2" >>>>]
                                                   >>,
                           else |-> <<[type |-> "skip"]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]