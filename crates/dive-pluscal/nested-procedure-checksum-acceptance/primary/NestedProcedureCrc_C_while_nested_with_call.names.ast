[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Put", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Put">>,
               params |-> <<[var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "P",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "a" >>]>>]>>], 
                            [label |-> "R",
                             stmts |-> <<[type |-> "return", from |-> "Put"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type    |-> "while", 
                           test    |-> << "x", "=", "0" >>,
                           labDo   |-> <<[label |-> "B",
                                          stmts |-> <<[type |-> "skip"]>>]>>,
                           unlabDo |-> <<[type   |-> "with", 
                                          var    |-> "q",
                                          eqOrIn |-> "=",
                                          exp    |-> << "2" >>,
                                          do     |-> <<[type     |-> "callGoto",
                                                        after    |-> "B",
                                                        to       |-> "Put",
                                                       args     |-> <<<< "q" >>>>]
                                                                    >>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]