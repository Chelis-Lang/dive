[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Put", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Put">>,
               params |-> <<[var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "P",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "a" >>]>>]>>], 
                            [label |-> "R",
                             stmts |-> <<[type |-> "return", from |-> "Put"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type    |-> "while", 
                           test    |-> << "x", "=", "0" >>,
                           labDo   |-> <<[label |-> "B",
                                          stmts |-> <<[type |-> "skip"]>>]>>,
                           unlabDo |-> <<[type   |-> "with", 
                                          var    |-> "q",
                                          eqOrIn |-> "=",
                                          exp    |-> << "2" >>,
                                          do     |-> <<[type |-> "assignment",
                                                        ass  |-> <<[lhs |-> [var |-> "a", sub |-> <<  >>],
                                                                    rhs |-> << "q" >>], 
                                                                   [lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                                    rhs |-> << "<<", "[", "procedure", "|->", "\"", "Put", "\"", ","
, "pc", "|->", "\"", "B", "\"", ","
, "a", "|->", "a", "]", ">>"
, "\\o", "stack" >>]>>], 
                                                       [type |-> "assignment",
                                                        ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                    rhs |-> << "\"", "P", "\"" >>]>>]>>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]