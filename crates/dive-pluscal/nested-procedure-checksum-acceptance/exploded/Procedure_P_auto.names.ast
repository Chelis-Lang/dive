[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Put", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Put">>,
               params |-> <<[var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "Lbl_1",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "a" >>]>>], 
                                         [type |-> "return", from |-> "Put"]>>]>>]>>,
 body  |-> <<[label |-> "Lbl_2",
              stmts |-> <<[type     |-> "call",
