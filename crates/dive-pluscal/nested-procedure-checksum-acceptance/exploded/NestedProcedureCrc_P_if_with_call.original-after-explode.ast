[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Put", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Put">>,
               params |-> <<[var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "P",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "a" >>]>>]>>], 
                            [label |-> "R",
                             stmts |-> <<[type |-> "return", from |-> "Put"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type    |-> "if", 
                           test    |-> << "x", "=", "0" >>,
                           then |-> <<[type   |-> "with", 
                                       var    |-> "q",
                                       eqOrIn |-> "=",
                                       exp    |-> << "2" >>,
                                       do     |-> <<[type |-> "assignment",
                                                     ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                                 rhs |-> << "<<", "[", "procedure", "|->", "\"", "Put", "\"", ","
, "pc", "|->", "\"", "E", "\"", ","
, "a", "|->", "a", "]", ">>"
, "\\o", "stack" >>], 
                                                                [lhs |-> [var |-> "a", sub |-> <<  >>],
                                                                 rhs |-> << "q" >>]>>], 
                                                    [type |-> "assignment",
                                                     ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                 rhs |-> << "\"", "P", "\"" >>]>>]>>]>>,
                           else |-> <<[type |-> "skip"], 
                                      [type |-> "assignment",
                                       ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                   rhs |-> << "\"", "E", "\"" >>]>>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]