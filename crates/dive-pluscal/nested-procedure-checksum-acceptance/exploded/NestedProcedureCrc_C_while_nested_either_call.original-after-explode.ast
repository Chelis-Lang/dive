[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Put", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Put">>,
               params |-> <<[var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "P",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "a" >>]>>]>>], 
                            [label |-> "R",
                             stmts |-> <<[type |-> "return", from |-> "Put"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type    |-> "while", 
                           test    |-> << "x", "=", "0" >>,
                           labDo   |-> <<[label |-> "B",
                                          stmts |-> <<[type |-> "skip"]>>]>>,
                           unlabDo |-> <<[type |-> "either", 
                                          ors  |-> << <<[type |-> "assignment",
                                                         ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                                     rhs |-> << "<<", "[", "procedure", "|->", "\"", "Put", "\"", ","
, "pc", "|->", "\"", "B", "\"", ","
, "a", "|->", "a", "]", ">>"
, "\\o", "stack" >>], 
                                                                    [lhs |-> [var |-> "a", sub |-> <<  >>],
                                                                     rhs |-> << "2" >>]>>], 
                                                        [type |-> "assignment",
                                                         ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                     rhs |-> << "\"", "P", "\"" >>]>>]>>, 
                                                      <<[type |-> "skip"], 
                                                        [type |-> "assignment",
                                                         ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                     rhs |-> << "\"", "B", "\"" >>]>>]>> >>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]