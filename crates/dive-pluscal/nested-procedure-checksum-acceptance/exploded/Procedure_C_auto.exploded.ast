[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Put", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
               params |-> <<[var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "Lbl_1",
                             stmts |-> <<[type |-> "when", 
                                          exp |-> << "pc", "=", "\"", "Lbl_1", "\"" >>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "a" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                      rhs |-> << "Head", "(", "stack", ")", ".", "pc" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "a", sub |-> <<  >>],
                                                      rhs |-> << "Head", "(", "stack", ")", ".", "a" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                      rhs |-> << "Tail", "(", "stack", ")" >>]>>]>>]>>]>>,
 body  |-> <<[label |-> "Lbl_2",
              stmts |-> <<[type |-> "when", 
                           exp |-> << "pc", "=", "\"", "Lbl_2", "\"" >>], 
                          [type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                       rhs |-> << "<<", "[", "procedure", "|->", "\"", "Put", "\"", ","
, "pc", "|->", "\"", "Lbl_3", "\"", ","
, "a", "|->", "a", "]", ">>"
, "\\o", "stack" >>], 
                                      [lhs |-> [var |-> "a", sub |-> <<  >>],
                                       rhs |-> << "2" >>]>>], 
                          [type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                       rhs |-> << "\"", "Lbl_1", "\"" >>]>>]>>], 
             [label |-> "Lbl_3",
              stmts |-> <<[type |-> "when", 
                           exp |-> << "pc", "=", "\"", "Lbl_3", "\"" >>], 
                          [type |-> "skip"], 
                          [type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                       rhs |-> << "\"", "Done", "\"" >>]>>]>>]>>]