[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Put", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Put">>,
               params |-> <<[var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "P",
                             stmts |-> <<[type    |-> "if", 
                                          test    |-> << "a", "=", "0" >>,
                                          then |-> <<[type |-> "return", from |-> "Put"]>>,
                                          else |-> <<[type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                                  rhs |-> << "a" >>]>>]>>]>>], 
                            [label |-> "R",
                             stmts |-> <<[type |-> "return", from |-> "Put"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type     |-> "call",
                           returnTo |-> "",
                           to       |-> "Put",
                           args     |-> <<<< "2" >>>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]