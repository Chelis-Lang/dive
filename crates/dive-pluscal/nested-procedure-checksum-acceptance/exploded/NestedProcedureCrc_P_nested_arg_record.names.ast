[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Put", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Put">>,
               params |-> <<[var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "P",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "a" >>]>>]>>], 
                            [label |-> "R",
                             stmts |-> <<[type |-> "return", from |-> "Put"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type   |-> "with", 
                           var    |-> "q",
                           eqOrIn |-> "=",
                           exp    |-> << "[", "v", "|->", "2", "]" >>,
                           do     |-> <<[type     |-> "callGoto",
                                         after    |-> "E",
                                         to       |-> "Put",
                                        args     |-> <<<< "q", ".", "v" >>>>]
                                                     >>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]