[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>], 
              [var |-> "y", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> << "F", "==", "(col5) /\\", "x", "=", "0"
, "(col4) /\\", "y", "=", "0" >>,
 prcds  |-> <<>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type    |-> "if", 
                           test    |-> << "F" >>,
                           then |-> <<[type |-> "assignment",
                                       ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                   rhs |-> << "1" >>]>>]>>,
                           else |-> <<>>]>>]>>]