[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type    |-> "while", 
                           test    |-> << "x", "<", "2" >>,
                           labDo   |-> <<[label |-> "B",
                                          stmts |-> <<[type |-> "skip"]>>]>>,
                           unlabDo |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "x", "+", "1" >>]>>]>>]>>]>>]