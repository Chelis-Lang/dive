[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "CASE", "TRUE", "->", "1"
, "[]", "OTHER", "->", "0" >>], 
              [var |-> "y", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type |-> "skip"]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]