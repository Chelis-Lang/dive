[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Put", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Put">>,
               params |-> <<[var |-> "z", eqOrIn |-> "=", val |-> << "0" >>], 
                            [var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "P",
                             stmts |-> <<[type    |-> "while", 
                                          test    |-> << "x", "<", "0" >>,
                                          labDo   |-> <<>>,
                                          unlabDo |-> <<[type    |-> "if", 
                                                         test    |-> << "x", "=", "0" >>,
                                                         then |-> <<[type |-> "assignment",
                                                                     ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                                 rhs |-> << "Head", "(", "stack", ")", ".", "pc" >>]>>], 
                                                                    [type |-> "assignment",
                                                                     ass  |-> <<[lhs |-> [var |-> "z", sub |-> <<  >>],
                                                                                 rhs |-> << "Head", "(", "stack", ")", ".", "z" >>]>>], 
                                                                    [type |-> "assignment",
                                                                     ass  |-> <<[lhs |-> [var |-> "a", sub |-> <<  >>],
                                                                                 rhs |-> << "Head", "(", "stack", ")", ".", "a" >>]>>], 
                                                                    [type |-> "assignment",
                                                                     ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                                                 rhs |-> << "Tail", "(", "stack", ")" >>]>>]>>,
                                                         else |-> <<[type    |-> "if", 
                                                                     test    |-> << "x", "=", "1" >>,
                                                                     then |-> <<[type |-> "skip"], 
                                                                                [type |-> "assignment",
                                                                                 ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                                             rhs |-> << "\"", "P", "\"" >>]>>]>>,
                                                                     else |-> <<[type |-> "assignment",
                                                                                 ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                                             rhs |-> << "Head", "(", "stack", ")", ".", "pc" >>]>>], 
                                                                                [type |-> "assignment",
                                                                                 ass  |-> <<[lhs |-> [var |-> "z", sub |-> <<  >>],
                                                                                             rhs |-> << "Head", "(", "stack", ")", ".", "z" >>]>>], 
                                                                                [type |-> "assignment",
                                                                                 ass  |-> <<[lhs |-> [var |-> "a", sub |-> <<  >>],
                                                                                             rhs |-> << "Head", "(", "stack", ")", ".", "a" >>]>>], 
                                                                                [type |-> "assignment",
                                                                                 ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                                                             rhs |-> << "Tail", "(", "stack", ")" >>]>>]>>]>>]>>]>>], 
                            [label |-> "R",
                             stmts |-> <<[type |-> "return", from |-> "Put"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type     |-> "callGoto",
                           after    |-> "E",
                           to       |-> "Put",
                          args     |-> <<<< "1" >>, 
                                         << "2" >>>>]
                                       >>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]