[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Put", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Put">>,
               params |-> <<[var |-> "z", eqOrIn |-> "=", val |-> << "0" >>], 
                            [var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "P",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "a", "+", "z" >>]>>]>>], 
                            [label |-> "R",
                             stmts |-> <<[type |-> "return", from |-> "Put"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type    |-> "if", 
                           test    |-> << "x", "=", "0" >>,
                           then |-> <<[type |-> "assignment",
                                       ass  |-> <<[lhs |-> [var |-> "a", sub |-> <<  >>],
                                                   rhs |-> << "2" >>], 
                                                  [lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                   rhs |-> << "<<", "[", "procedure", "|->", "\"", "Put", "\"", ","
, "pc", "|->", "\"", "E", "\"", ","
, "z", "|->", "z", ","
, "a", "|->", "a", "]", ">>"
, "\\o", "stack" >>], 
                                                  [lhs |-> [var |-> "z", sub |-> <<  >>],
                                                   rhs |-> << "1" >>]>>], 
                                      [type |-> "assignment",
                                       ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                   rhs |-> << "\"", "P", "\"" >>]>>]>>,
                           else |-> <<[type    |-> "if", 
                                       test    |-> << "x", "=", "1" >>,
                                       then |-> <<[type |-> "skip"]>>,
                                       else |-> <<[type |-> "skip"]>>], 
                                      [type |-> "assignment",
                                       ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                   rhs |-> << "\"", "E", "\"" >>]>>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]