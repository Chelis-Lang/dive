[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>], 
              [var |-> "y", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<>>,
 body  |-> <<[label |-> "M1",
              stmts |-> <<[type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                       rhs |-> << "1" >>]>>], 
                          [type |-> "skip"]>>]>>]