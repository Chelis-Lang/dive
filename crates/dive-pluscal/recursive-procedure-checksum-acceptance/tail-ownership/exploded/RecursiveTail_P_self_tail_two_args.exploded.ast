[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Recur", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
               params |-> <<[var |-> "n", eqOrIn |-> "=", val |-> << "0" >>], 
                            [var |-> "k", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "R1",
                             stmts |-> <<[type |-> "when", 
                                          exp |-> << "pc", "=", "\"", "R1", "\"" >>], 
                                         [type    |-> "if", 
                                          test    |-> << "n", ">", "0" >>,
                                          then |-> <<[type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "n", sub |-> <<  >>],
                                                                  rhs |-> << "n", "-", "1" >>], 
                                                                 [lhs |-> [var |-> "k", sub |-> <<  >>],
                                                                  rhs |-> << "k", "+", "1" >>]>>], 
                                                     [type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                  rhs |-> << "\"", "R1", "\"" >>]>>]>>,
                                          else |-> <<[type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                                  rhs |-> << "k" >>]>>], 
                                                     [type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                  rhs |-> << "\"", "R2", "\"" >>]>>]>>]>>], 
                            [label |-> "R2",
                             stmts |-> <<[type |-> "when", 
                                          exp |-> << "pc", "=", "\"", "R2", "\"" >>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                      rhs |-> << "Head", "(", "stack", ")", ".", "pc" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "n", sub |-> <<  >>],
                                                      rhs |-> << "Head", "(", "stack", ")", ".", "n" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "k", sub |-> <<  >>],
                                                      rhs |-> << "Head", "(", "stack", ")", ".", "k" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                      rhs |-> << "Tail", "(", "stack", ")" >>]>>]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type |-> "when", 
                           exp |-> << "pc", "=", "\"", "L", "\"" >>], 
                          [type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                       rhs |-> << "<<", "[", "procedure", "|->", "\"", "Recur", "\"", ","
, "pc", "|->", "\"", "E", "\"", ","
, "n", "|->", "n", ","
, "k", "|->", "k", "]", ">>"
, "\\o", "stack" >>], 
                                      [lhs |-> [var |-> "n", sub |-> <<  >>],
                                       rhs |-> << "2" >>], 
                                      [lhs |-> [var |-> "k", sub |-> <<  >>],
                                       rhs |-> << "0" >>]>>], 
                          [type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                       rhs |-> << "\"", "R1", "\"" >>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "when", 
                           exp |-> << "pc", "=", "\"", "E", "\"" >>], 
                          [type |-> "skip"], 
                          [type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                       rhs |-> << "\"", "Done", "\"" >>]>>]>>]>>]