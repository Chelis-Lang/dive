[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Recur", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Other">>,
               params |-> <<[var |-> "n", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<[var |-> "v", eqOrIn |-> "=", val |-> << "n" >>]>>,
               body   |-> <<[label |-> "R1",
                             stmts |-> <<[type    |-> "if", 
                                          test    |-> << "n", ">", "0" >>,
                                          then |-> <<[type     |-> "callReturn",
                                                      from     |-> "Recur",
                                                      to       |-> "Other",
                                                     args     |-> <<<< "n", "-", "1" >>>>]
                                                                  >>,
                                          else |-> <<[type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                                  rhs |-> << "x", "+", "1" >>]>>]>>]>>], 
                            [label |-> "R2",
                             stmts |-> <<[type |-> "return", from |-> "Recur"]>>]>>], 
              [name   |-> "Other", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Recur">>,
               params |-> <<[var |-> "m", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<[var |-> "q", eqOrIn |-> "=", val |-> << "m" >>]>>,
               body   |-> <<[label |-> "O1",
                             stmts |-> <<[type    |-> "if", 
                                          test    |-> << "m", ">", "0" >>,
                                          then |-> <<[type     |-> "callReturn",
                                                      from     |-> "Other",
                                                      to       |-> "Recur",
                                                     args     |-> <<<< "m", "-", "1" >>>>]
                                                                  >>,
                                          else |-> <<[type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                                  rhs |-> << "x", "+", "1" >>]>>]>>]>>], 
                            [label |-> "O2",
                             stmts |-> <<[type |-> "return", from |-> "Other"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type     |-> "call",
                           returnTo |-> "",
                           to       |-> "Recur",
                           args     |-> <<<< "3" >>>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]