[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Other", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
               params |-> <<[var |-> "m", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<[var |-> "q", eqOrIn |-> "=", val |-> << "m" >>]>>,
               body   |-> <<[label |-> "O1",
                             stmts |-> <<[type |-> "when", 
                                          exp |-> << "pc", "=", "\"", "O1", "\"" >>], 
                                         [type    |-> "if", 
                                          test    |-> << "m", ">", "0" >>,
                                          then |-> <<[type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "q", sub |-> <<  >>],
                                                                  rhs |-> << "Head", "(", "stack", ")", ".", "q" >>], 
                                                                 [lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                                  rhs |-> << "<<", "[", "procedure", "|->", "\"", "Recur", "\"", ","
, "pc", "|->", "Head", "(", "stack", ")", ".", "pc", ","
, "v", "|->", "v", ","
, "n", "|->", "n", "]", ">>"
, "\\o", "Tail", "(", "stack", ")" >>], 
                                                                 [lhs |-> [var |-> "n", sub |-> <<  >>],
                                                                  rhs |-> << "m", "-", "1" >>]>>], 
                                                     [type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "v", sub |-> <<  >>],
                                                                  rhs |-> << "n" >>]>>], 
                                                     [type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                  rhs |-> << "\"", "R1", "\"" >>]>>]>>,
                                          else |-> <<[type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                                  rhs |-> << "x", "+", "1" >>]>>], 
                                                     [type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                  rhs |-> << "\"", "O2", "\"" >>]>>]>>]>>], 
                            [label |-> "O2",
                             stmts |-> <<[type |-> "when", 
                                          exp |-> << "pc", "=", "\"", "O2", "\"" >>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                      rhs |-> << "Head", "(", "stack", ")", ".", "pc" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "q", sub |-> <<  >>],
                                                      rhs |-> << "Head", "(", "stack", ")", ".", "q" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "m", sub |-> <<  >>],
                                                      rhs |-> << "Head", "(", "stack", ")", ".", "m" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                      rhs |-> << "Tail", "(", "stack", ")" >>]>>]>>]>>], 
              [name   |-> "Recur", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
               params |-> <<[var |-> "n", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<[var |-> "v", eqOrIn |-> "=", val |-> << "n" >>]>>,
               body   |-> <<[label |-> "R1",
                             stmts |-> <<[type |-> "when", 
                                          exp |-> << "pc", "=", "\"", "R1", "\"" >>], 
                                         [type    |-> "if", 
                                          test    |-> << "n", ">", "0" >>,
                                          then |-> <<[type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "v", sub |-> <<  >>],
                                                                  rhs |-> << "Head", "(", "stack", ")", ".", "v" >>], 
                                                                 [lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                                  rhs |-> << "<<", "[", "procedure", "|->", "\"", "Other", "\"", ","
, "pc", "|->", "Head", "(", "stack", ")", ".", "pc", ","
, "q", "|->", "q", ","
, "m", "|->", "m", "]", ">>"
, "\\o", "Tail", "(", "stack", ")" >>], 
                                                                 [lhs |-> [var |-> "m", sub |-> <<  >>],
                                                                  rhs |-> << "n", "-", "1" >>]>>], 
                                                     [type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "q", sub |-> <<  >>],
                                                                  rhs |-> << "m" >>]>>], 
                                                     [type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                  rhs |-> << "\"", "O1", "\"" >>]>>]>>,
                                          else |-> <<[type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                                  rhs |-> << "x", "+", "1" >>]>>], 
                                                     [type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                  rhs |-> << "\"", "R2", "\"" >>]>>]>>]>>], 
                            [label |-> "R2",
                             stmts |-> <<[type |-> "when", 
                                          exp |-> << "pc", "=", "\"", "R2", "\"" >>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                      rhs |-> << "Head", "(", "stack", ")", ".", "pc" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "v", sub |-> <<  >>],
                                                      rhs |-> << "Head", "(", "stack", ")", ".", "v" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "n", sub |-> <<  >>],
                                                      rhs |-> << "Head", "(", "stack", ")", ".", "n" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                      rhs |-> << "Tail", "(", "stack", ")" >>]>>]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type |-> "when", 
                           exp |-> << "pc", "=", "\"", "L", "\"" >>], 
                          [type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                       rhs |-> << "<<", "[", "procedure", "|->", "\"", "Recur", "\"", ","
, "pc", "|->", "\"", "E", "\"", ","
, "v", "|->", "v", ","
, "n", "|->", "n", "]", ">>"
, "\\o", "stack" >>], 
                                      [lhs |-> [var |-> "n", sub |-> <<  >>],
                                       rhs |-> << "3" >>]>>], 
                          [type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "v", sub |-> <<  >>],
                                       rhs |-> << "n" >>]>>], 
                          [type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                       rhs |-> << "\"", "R1", "\"" >>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "when", 
                           exp |-> << "pc", "=", "\"", "E", "\"" >>], 
                          [type |-> "skip"], 
                          [type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                       rhs |-> << "\"", "Done", "\"" >>]>>]>>]>>]