[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Recur", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Recur">>,
               params |-> <<[var |-> "n", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<[var |-> "v", eqOrIn |-> "=", val |-> << "n" >>]>>,
               body   |-> <<[label |-> "R1",
                             stmts |-> <<[type    |-> "if", 
                                          test    |-> << "n", ">", "0" >>,
                                          then |-> <<[type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "n", sub |-> <<  >>],
                                                                  rhs |-> << "n", "-", "1" >>]>>], 
                                                     [type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "v", sub |-> <<  >>],
                                                                  rhs |-> << "n" >>]>>], 
                                                     [type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                  rhs |-> << "\"", "R1", "\"" >>]>>]>>,
                                          else |-> <<[type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                                  rhs |-> << "x", "+", "v", "+", "1" >>]>>], 
                                                     [type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                  rhs |-> << "Head", "(", "stack", ")", ".", "pc" >>]>>], 
                                                     [type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "v", sub |-> <<  >>],
                                                                  rhs |-> << "Head", "(", "stack", ")", ".", "v" >>]>>], 
                                                     [type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "n", sub |-> <<  >>],
                                                                  rhs |-> << "Head", "(", "stack", ")", ".", "n" >>]>>], 
                                                     [type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                                  rhs |-> << "Tail", "(", "stack", ")" >>]>>]>>]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type     |-> "call",
                           returnTo |-> "",
                           to       |-> "Recur",
                           args     |-> <<<< "2" >>>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]