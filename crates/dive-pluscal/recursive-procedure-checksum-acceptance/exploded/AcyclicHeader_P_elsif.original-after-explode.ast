[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Outer", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Inner">>,
               params |-> <<[var |-> "p", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "O1",
                             stmts |-> <<[type    |-> "if", 
                                          test    |-> << "p", "=", "0" >>,
                                          then |-> <<[type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                                  rhs |-> << "0" >>]>>], 
                                                     [type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                  rhs |-> << "\"", "O2", "\"" >>]>>]>>,
                                          else |-> <<[type    |-> "if", 
                                                      test    |-> << "p", "=", "1" >>,
                                                      then |-> <<[type |-> "assignment",
                                                                  ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                                              rhs |-> << "<<", "[", "procedure", "|->", "\"", "Inner", "\"", ","
, "pc", "|->", "\"", "O2", "\"", ","
, "q", "|->", "q", "]", ">>"
, "\\o", "stack" >>], 
                                                                             [lhs |-> [var |-> "q", sub |-> <<  >>],
                                                                              rhs |-> << "p" >>]>>], 
                                                                 [type |-> "assignment",
                                                                  ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                              rhs |-> << "\"", "I1", "\"" >>]>>]>>,
                                                      else |-> <<[type |-> "assignment",
                                                                  ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                                              rhs |-> << "3" >>]>>], 
                                                                 [type |-> "assignment",
                                                                  ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                              rhs |-> << "\"", "O2", "\"" >>]>>]>>]>>]>>], 
                            [label |-> "O2",
                             stmts |-> <<[type |-> "return", from |-> "Outer"]>>]>>], 
              [name   |-> "Inner", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Outer">>,
               params |-> <<[var |-> "q", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "I1",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "q" >>]>>]>>], 
                            [label |-> "I2",
                             stmts |-> <<[type |-> "return", from |-> "Inner"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type     |-> "call",
                           returnTo |-> "",
                           to       |-> "Outer",
                           args     |-> <<<< "1" >>>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]