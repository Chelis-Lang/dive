[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Recur", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
               params |-> <<>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "R1",
                             stmts |-> <<[type |-> "when", 
                                          exp |-> << "pc", "=", "\"", "R1", "\"" >>], 
                                         [type |-> "assignment",
                                          ass  |-> <<>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                      rhs |-> << "\"", "R1", "\"" >>]>>]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type |-> "when", 
                           exp |-> << "pc", "=", "\"", "L", "\"" >>], 
                          [type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                       rhs |-> << "<<", "[", "procedure", "|->", "\"", "Recur", "\"", ","
, "pc", "|->", "\"", "E", "\"", "]", ">>"
, "\\o", "stack" >>]>>], 
                          [type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                       rhs |-> << "\"", "R1", "\"" >>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "when", 
                           exp |-> << "pc", "=", "\"", "E", "\"" >>], 
                          [type |-> "skip"], 
                          [type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                       rhs |-> << "\"", "Done", "\"" >>]>>]>>]>>]