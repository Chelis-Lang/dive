[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Recur", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Recur">>,
               params |-> <<[var |-> "n", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "R1",
                             stmts |-> <<[type    |-> "while", 
                                          test    |-> << "n", ">", "0" >>,
                                          labDo   |-> <<[label |-> "WC",
                                                         stmts |-> <<[type     |-> "call",
                                                                      returnTo |-> "",
                                                                      to       |-> "Recur",
                                                                      args     |-> <<<< "n", "-", "1" >>>>]>>], 
                                                        [label |-> "WA",
                                                         stmts |-> <<[type |-> "assignment",
                                                                      ass  |-> <<[lhs |-> [var |-> "n", sub |-> <<  >>],
                                                                                  rhs |-> << "0" >>]>>]>>]>>,
                                          unlabDo |-> <<>>]>>], 
                            [label |-> "R2",
                             stmts |-> <<[type |-> "return", from |-> "Recur"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type     |-> "call",
                           returnTo |-> "",
                           to       |-> "Recur",
                           args     |-> <<<< "2" >>>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]