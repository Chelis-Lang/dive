[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Recur", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
               params |-> <<[var |-> "n", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "R1",
                             stmts |-> <<[type |-> "when", 
                                          exp |-> << "pc", "=", "\"", "R1", "\"" >>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                      rhs |-> << "<<", "[", "procedure", "|->", "\"", "Recur", "\"", ","
, "pc", "|->", "\"", "R2", "\"", ","
, "n", "|->", "n", "]", ">>"
, "\\o", "stack" >>], 
                                                     [lhs |-> [var |-> "n", sub |-> <<  >>],
                                                      rhs |-> << "n" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                      rhs |-> << "\"", "R1", "\"" >>]>>]>>], 
                            [label |-> "R2",
                             stmts |-> <<[type |-> "when", 
                                          exp |-> << "pc", "=", "\"", "R2", "\"" >>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                      rhs |-> << "Head", "(", "stack", ")", ".", "pc" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "n", sub |-> <<  >>],
                                                      rhs |-> << "Head", "(", "stack", ")", ".", "n" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                      rhs |-> << "Tail", "(", "stack", ")" >>]>>]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type |-> "when", 
                           exp |-> << "pc", "=", "\"", "L", "\"" >>], 
                          [type |-> "skip"], 
                          [type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                       rhs |-> << "\"", "Done", "\"" >>]>>]>>]>>]