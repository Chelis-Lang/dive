[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Recur", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Recur">>,
               params |-> <<[var |-> "n", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "R1",
                             stmts |-> <<[type    |-> "if", 
                                          test    |-> << "n", ">", "0" >>,
                                          then |-> <<[type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                                  rhs |-> << "<<", "[", "procedure", "|->", "\"", "Recur", "\"", ","
, "pc", "|->", "\"", "R2", "\"", ","
, "n", "|->", "n", "]", ">>"
, "\\o", "stack" >>], 
                                                                 [lhs |-> [var |-> "n", sub |-> <<  >>],
                                                                  rhs |-> << "n", "-", "1" >>]>>], 
                                                     [type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                  rhs |-> << "\"", "R1", "\"" >>]>>]>>,
                                          else |-> <<[type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                                  rhs |-> << "x", "+", "1" >>]>>], 
                                                     [type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                  rhs |-> << "\"", "R2", "\"" >>]>>]>>]>>], 
                            [label |-> "R2",
                             stmts |-> <<[type |-> "return", from |-> "Recur"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type     |-> "call",
                           returnTo |-> "",
                           to       |-> "Recur",
                           args     |-> <<<< "2" >>>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]