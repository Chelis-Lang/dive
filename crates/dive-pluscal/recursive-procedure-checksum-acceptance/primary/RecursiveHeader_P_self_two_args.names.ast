[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Recur", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Recur">>,
               params |-> <<[var |-> "n", eqOrIn |-> "=", val |-> << "0" >>], 
                            [var |-> "k", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "R1",
                             stmts |-> <<[type    |-> "if", 
                                          test    |-> << "n", ">", "0" >>,
                                          then |-> <<[type     |-> "call",
                                                      returnTo |-> "",
                                                      to       |-> "Recur",
                                                      args     |-> <<<< "n", "-", "1" >>, 
                                                                     << "k", "+", "1" >>>>]>>,
                                          else |-> <<[type |-> "assignment",
                                                      ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                                  rhs |-> << "k" >>]>>]>>]>>], 
                            [label |-> "R2",
                             stmts |-> <<[type |-> "return", from |-> "Recur"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type     |-> "call",
                           returnTo |-> "",
                           to       |-> "Recur",
                           args     |-> <<<< "2" >>, 
                                          << "0" >>>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]