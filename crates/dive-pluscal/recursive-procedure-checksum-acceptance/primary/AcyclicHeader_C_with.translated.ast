[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Outer", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Inner">>,
               params |-> <<[var |-> "p", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "O1",
                             stmts |-> <<[type   |-> "with", 
                                          var    |-> "t",
                                          eqOrIn |-> "=",
                                          exp    |-> << "p", "+", "1" >>,
                                          do     |-> <<[type |-> "assignment",
                                                        ass  |-> <<[lhs |-> [var |-> "q", sub |-> <<  >>],
                                                                    rhs |-> << "t" >>], 
                                                                   [lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                                    rhs |-> << "<<", "[", "procedure", "|->", "\"", "Inner", "\"", ","
, "pc", "|->", "\"", "O2", "\"", ","
, "q", "|->", "q", "]", ">>"
, "\\o", "stack" >>]>>], 
                                                       [type |-> "assignment",
                                                        ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                                    rhs |-> << "\"", "I1", "\"" >>]>>]>>]>>], 
                            [label |-> "O2",
                             stmts |-> <<[type |-> "return", from |-> "Outer"]>>]>>], 
              [name   |-> "Inner", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Outer">>,
               params |-> <<[var |-> "q", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "I1",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "q" >>]>>]>>], 
                            [label |-> "I2",
                             stmts |-> <<[type |-> "return", from |-> "Inner"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type     |-> "call",
                           returnTo |-> "",
                           to       |-> "Outer",
                           args     |-> <<<< "1" >>>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]