[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Put", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Put">>,
               params |-> <<[var |-> "z", eqOrIn |-> "=", val |-> << "0" >>], 
                            [var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "P",
                             stmts |-> <<[type |-> "either", 
                                          ors  |-> << <<[type    |-> "if", 
                                                         test    |-> << "x", "=", "0" >>,
                                                         then |-> <<[type |-> "return", from |-> "Put"]>>,
                                                         else |-> <<[type    |-> "if", 
                                                                     test    |-> << "x", "=", "1" >>,
                                                                     then |-> <<[type |-> "skip"]>>,
                                                                     else |-> <<[type |-> "return", from |-> "Put"]>>]>>]>>, 
                                                      <<[type |-> "skip"]>> >>]>>], 
                            [label |-> "R",
                             stmts |-> <<[type |-> "return", from |-> "Put"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type     |-> "callGoto",
                           after    |-> "E",
                           to       |-> "Put",
                          args     |-> <<<< "1" >>, 
                                         << "2" >>>>]
                                       >>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]