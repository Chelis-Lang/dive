[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Put", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<"Put">>,
               params |-> <<[var |-> "z", eqOrIn |-> "=", val |-> << "0" >>], 
                            [var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "P",
                             stmts |-> <<[type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "a", "+", "z" >>]>>]>>], 
                            [label |-> "R",
                             stmts |-> <<[type |-> "return", from |-> "Put"]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type   |-> "with", 
                           var    |-> "q",
                           eqOrIn |-> "=",
                           exp    |-> << "2" >>,
                           do     |-> <<[type    |-> "if", 
                                         test    |-> << "x", "=", "0" >>,
                                         then |-> <<[type     |-> "callGoto",
                                                     after    |-> "E",
                                                     to       |-> "Put",
                                                    args     |-> <<<< "1" >>, 
                                                                   << "2" >>>>]
                                                                 >>,
                                         else |-> <<[type    |-> "if", 
                                                     test    |-> << "x", "=", "1" >>,
                                                     then |-> <<[type |-> "skip"]>>,
                                                     else |-> <<[type     |-> "callGoto",
                                                                 after    |-> "E",
                                                                 to       |-> "Put",
                                                                args     |-> <<<< "1" >>, 
                                                                               << "2" >>>>]
                                                                             >>]>>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "skip"]>>]>>]