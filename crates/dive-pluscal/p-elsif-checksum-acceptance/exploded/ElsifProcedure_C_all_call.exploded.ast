[type     |-> "uniprocess", 
 name  |-> "A", 
 decls  |-> <<[var |-> "x", eqOrIn |-> "=", val |-> << "0" >>]>>,
 defs   |-> <<  >>,
 prcds  |-> <<[name   |-> "Put", 
              minusLabels |-> <<>>, plusLabels |-><<>>, proceduresCalled |-><<>>,
               params |-> <<[var |-> "z", eqOrIn |-> "=", val |-> << "0" >>], 
                            [var |-> "a", eqOrIn |-> "=", val |-> << "0" >>]>>,
               decls  |-> <<>>,
               body   |-> <<[label |-> "P",
                             stmts |-> <<[type |-> "when", 
                                          exp |-> << "pc", "=", "\"", "P", "\"" >>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "x", sub |-> <<  >>],
                                                      rhs |-> << "a", "+", "z" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                      rhs |-> << "\"", "R", "\"" >>]>>]>>], 
                            [label |-> "R",
                             stmts |-> <<[type |-> "when", 
                                          exp |-> << "pc", "=", "\"", "R", "\"" >>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                      rhs |-> << "Head", "(", "stack", ")", ".", "pc" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "z", sub |-> <<  >>],
                                                      rhs |-> << "Head", "(", "stack", ")", ".", "z" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "a", sub |-> <<  >>],
                                                      rhs |-> << "Head", "(", "stack", ")", ".", "a" >>]>>], 
                                         [type |-> "assignment",
                                          ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                      rhs |-> << "Tail", "(", "stack", ")" >>]>>]>>]>>]>>,
 body  |-> <<[label |-> "L",
              stmts |-> <<[type |-> "when", 
                           exp |-> << "pc", "=", "\"", "L", "\"" >>], 
                          [type    |-> "if", 
                           test    |-> << "x", "=", "0" >>,
                           then |-> <<[type |-> "assignment",
                                       ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                   rhs |-> << "<<", "[", "procedure", "|->", "\"", "Put", "\"", ","
, "pc", "|->", "\"", "E", "\"", ","
, "z", "|->", "z", ","
, "a", "|->", "a", "]", ">>"
, "\\o", "stack" >>], 
                                                  [lhs |-> [var |-> "z", sub |-> <<  >>],
                                                   rhs |-> << "1" >>], 
                                                  [lhs |-> [var |-> "a", sub |-> <<  >>],
                                                   rhs |-> << "2" >>]>>], 
                                      [type |-> "assignment",
                                       ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                   rhs |-> << "\"", "P", "\"" >>]>>]>>,
                           else |-> <<[type    |-> "if", 
                                       test    |-> << "x", "=", "1" >>,
                                       then |-> <<[type |-> "assignment",
                                                   ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                               rhs |-> << "<<", "[", "procedure", "|->", "\"", "Put", "\"", ","
, "pc", "|->", "\"", "E", "\"", ","
, "z", "|->", "z", ","
, "a", "|->", "a", "]", ">>"
, "\\o", "stack" >>], 
                                                              [lhs |-> [var |-> "z", sub |-> <<  >>],
                                                               rhs |-> << "1" >>], 
                                                              [lhs |-> [var |-> "a", sub |-> <<  >>],
                                                               rhs |-> << "2" >>]>>], 
                                                  [type |-> "assignment",
                                                   ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                               rhs |-> << "\"", "P", "\"" >>]>>]>>,
                                       else |-> <<[type |-> "assignment",
                                                   ass  |-> <<[lhs |-> [var |-> "stack", sub |-> <<  >>],
                                                               rhs |-> << "<<", "[", "procedure", "|->", "\"", "Put", "\"", ","
, "pc", "|->", "\"", "E", "\"", ","
, "z", "|->", "z", ","
, "a", "|->", "a", "]", ">>"
, "\\o", "stack" >>], 
                                                              [lhs |-> [var |-> "z", sub |-> <<  >>],
                                                               rhs |-> << "1" >>], 
                                                              [lhs |-> [var |-> "a", sub |-> <<  >>],
                                                               rhs |-> << "2" >>]>>], 
                                                  [type |-> "assignment",
                                                   ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                                               rhs |-> << "\"", "P", "\"" >>]>>]>>]>>]>>], 
             [label |-> "E",
              stmts |-> <<[type |-> "when", 
                           exp |-> << "pc", "=", "\"", "E", "\"" >>], 
                          [type |-> "skip"], 
                          [type |-> "assignment",
                           ass  |-> <<[lhs |-> [var |-> "pc", sub |-> <<  >>],
                                       rhs |-> << "\"", "Done", "\"" >>]>>]>>]>>]