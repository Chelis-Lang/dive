---- MODULE RvIntvOrder ----
EXTENDS Integers, TLC
ASSUME PrintT("#a") /\ PrintT({(-2000000000)..(-2000000000), 2000000000..2000000000})
ASSUME PrintT("#b") /\ PrintT(CHOOSE s \in {(-2000000000)..(-2000000000), 2000000000..2000000000} : TRUE)
ASSUME PrintT("#c") /\ PrintT({2000000000..2000000000, (-2000000000)..(-2000000000)})
ASSUME PrintT("#d") /\ PrintT({{2000000000}, (-2000000000)..(-2000000000)})
ASSUME PrintT("#e") /\ PrintT({[i \in 2000000000..2000000000 |-> 0], [i \in (-2000000000)..(-2000000000) |-> 0]})
ASSUME PrintT("#f") /\ PrintT({2147483647, -2147483647, 0})
ASSUME PrintT("#g") /\ PrintT({<<2000000000>>, <<-2000000000>>})
ASSUME PrintT("#h") /\ PrintT({(-2000000000)..(-1999999999), 2000000000..2000000001, 0..1})
====
