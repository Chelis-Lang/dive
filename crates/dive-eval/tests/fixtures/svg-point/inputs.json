[
  {
    "name": "Ordinary",
    "args": [
      "[x |-> 0,y |-> 0]",
      "[x |-> 9,y |-> 6]",
      "3"
    ],
    "expected": {
      "x": 3,
      "y": 2
    }
  },
  {
    "name": "NegativeTruncation",
    "args": [
      "[x |-> -3,y |-> -1]",
      "[x |-> 2,y |-> 4]",
      "3"
    ],
    "expected": {
      "x": -1,
      "y": 0
    }
  },
  {
    "name": "FractionAfterOffset",
    "args": [
      "[x |-> -3,y |-> -1]",
      "[x |-> 2,y |-> 4]",
      "2"
    ],
    "expected": {
      "x": 0,
      "y": 1
    }
  },
  {
    "name": "NegativeSegment",
    "args": [
      "[x |-> 3,y |-> -3]",
      "[x |-> 8,y |-> -8]",
      "-2"
    ],
    "expected": {
      "x": 0,
      "y": 0
    }
  },
  {
    "name": "ZeroNaN",
    "args": [
      "[x |-> -100,y |-> 123]",
      "[x |-> -100,y |-> 123]",
      "0"
    ],
    "expected": {
      "x": 0,
      "y": 0
    }
  },
  {
    "name": "ZeroInfinity",
    "args": [
      "[x |-> 0,y |-> 0]",
      "[x |-> 1,y |-> -1]",
      "0"
    ],
    "expected": {
      "x": 2147483647,
      "y": -2147483648
    }
  },
  {
    "name": "ZeroMixed",
    "args": [
      "[x |-> 0,y |-> -4]",
      "[x |-> 0,y |-> -8]",
      "0"
    ],
    "expected": {
      "x": 0,
      "y": -2147483648
    }
  },
  {
    "name": "WrappedDifference",
    "args": [
      "[x |-> (-2147483647 - 1),y |-> 2147483647]",
      "[x |-> 0,y |-> -1]",
      "1"
    ],
    "expected": {
      "x": -2147483648,
      "y": -1
    }
  },
  {
    "name": "Extremes",
    "args": [
      "[x |-> (-2147483647 - 1),y |-> 2147483647]",
      "[x |-> 2147483647,y |-> (-2147483647 - 1)]",
      "-1"
    ],
    "expected": {
      "x": -2147483647,
      "y": 2147483646
    }
  },
  {
    "name": "SegmentMin",
    "args": [
      "[x |-> 2147483647,y |-> (-2147483647 - 1)]",
      "[x |-> (-2147483647 - 1),y |-> 2147483647]",
      "(-2147483647 - 1)"
    ],
    "expected": {
      "x": 2147483647,
      "y": -2147483648
    }
  },
  {
    "name": "Extras",
    "args": [
      "[extra |-> <<1,2>>,y |-> 4,x |-> 2]",
      "[x |-> 8,y |-> 10,extra |-> FALSE]",
      "2"
    ],
    "expected": {
      "x": 5,
      "y": 7
    }
  },
  {
    "name": "ComputedRecord",
    "args": [
      "[k \\in {\"x\",\"y\"} |-> 0]",
      "[x |-> 8,y |-> 10]",
      "2"
    ]
  },
  {
    "name": "ConvertedRecord",
    "args": [
      "((\"x\" :> 0) @@ (\"y\" :> 0))",
      "[x |-> 8,y |-> 10]",
      "2"
    ]
  },
  {
    "name": "MissingX",
    "args": [
      "[y |-> 0]",
      "[x |-> 8,y |-> 10]",
      "2"
    ]
  },
  {
    "name": "MissingY",
    "args": [
      "[x |-> 0]",
      "[x |-> 8,y |-> 10]",
      "2"
    ]
  },
  {
    "name": "WrongCoordinate",
    "args": [
      "[x |-> TRUE,y |-> 0]",
      "[x |-> 8,y |-> 10]",
      "2"
    ]
  },
  {
    "name": "WrongRecord",
    "args": [
      "<<0,0>>",
      "[x |-> 8,y |-> 10]",
      "2"
    ]
  },
  {
    "name": "WrongSegment",
    "args": [
      "[x |-> 0,y |-> 0]",
      "[x |-> 8,y |-> 10]",
      "TRUE"
    ]
  },
  {
    "name": "ArgumentError",
    "args": [
      "<<0,0>>",
      "[x |-> 8,y |-> 10]",
      "1 \\div 0"
    ]
  }
]
