ASSUME PrintT({3, 1, 2} = {1, 2, 3})
ASSUME PrintT(2 \notin {1, 3})
ASSUME PrintT({1, 2} \X {3})
ASSUME PrintT(Cardinality({1, 2} \X {3, 4}))
ASSUME PrintT([a : {1, 2}, b : {3}])
ASSUME PrintT(Cardinality([{1, 2} -> {1, 2, 3}]))
ASSUME PrintT([{1, 2} -> {3}])
ASSUME PrintT({x \in SUBSET {1, 2, 3} : Cardinality(x) = 2})
ASSUME PrintT(UNION {1..2, 3..4})
ASSUME PrintT(-1 \in Nat \cup {-1})
ASSUME PrintT(5 \in {x \in Nat : x > 3})
ASSUME PrintT(2 \in {x \in Nat : x > 3})
ASSUME PrintT(IsFiniteSet({1}))
ASSUME PrintT({} = {})
ASSUME PrintT(SUBSET {})
ASSUME PrintT({{}})
ASSUME PrintT({1, 1, 2})
ASSUME PrintT(Cardinality({1, 1, 2}))
ASSUME PrintT({1, 2} \cup {})
ASSUME PrintT({} \cup {1})
