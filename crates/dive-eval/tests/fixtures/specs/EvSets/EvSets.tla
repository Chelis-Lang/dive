ASSUME PrintT(1..5 \cap 3..9)
ASSUME PrintT(1..5 \ {2, 3})
ASSUME PrintT({4, 5} \cup 1..2)
ASSUME PrintT(3 \in Nat \ {3})
ASSUME PrintT(4 \in Nat \ {3})
ASSUME PrintT(3 \in Nat \cap {3})
ASSUME PrintT(<<1, 2>> \in {1, 2} \X {2})
ASSUME PrintT({1} \in SUBSET {1, 2})
ASSUME PrintT([a |-> 1] \in [a : {1}])
ASSUME PrintT((1 :> 2) \in [{1} -> {2}])
ASSUME PrintT(<<1, 2>> \in [1..2 -> 1..2])
ASSUME PrintT(Cardinality(UNION {{1, 2}, {2, 3}}))
ASSUME PrintT({{1}, {1}} = {{1}})
ASSUME PrintT(SUBSET {1} = {{}, {1}})
