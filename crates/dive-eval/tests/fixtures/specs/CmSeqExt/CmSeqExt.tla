---- MODULE CmSeqExt ----
EXTENDS Integers, Sequences, FiniteSets, TLC, SequencesExt
ASSUME PrintT(SetToSeq({3, 1, 2}))
ASSUME PrintT(SetToSeq({}))
ASSUME PrintT(SetToSeq({"b", "a"}))
ASSUME PrintT(SetToSeqs({1, 2, 3}))
ASSUME PrintT(SetToSeqs({}))
ASSUME PrintT(Cardinality(SetToSeqs(1..4)))
ASSUME PrintT(Contains(<<1, 2, 3>>, 2))
ASSUME PrintT(Contains(<<>>, 2))
ASSUME PrintT(Contains(<<"a">>, "b"))
ASSUME PrintT(LongestCommonPrefix({<<1, 2, 3>>, <<1, 2, 4>>, <<1, 2>>}))
ASSUME PrintT(LongestCommonPrefix({<<>>}))
ASSUME PrintT(LongestCommonPrefix({"abc", "abd"}))
ASSUME PrintT(LongestCommonPrefix({<<1>>, <<2>>}))
ASSUME PrintT(FoldLeft(LAMBDA a, b: a - b, 10, <<1, 2, 3>>))
ASSUME PrintT(FoldRight(LAMBDA a, b: a - b, <<1, 2, 3>>, 10))
ASSUME PrintT(FoldLeftDomain(LAMBDA a, i: a * 10 + i, 0, <<"x", "y", "z">>))
ASSUME PrintT(FoldRightDomain(LAMBDA i, a: a * 10 + i, <<"x", "y", "z">>, 0))
ASSUME PrintT(FoldSeq(LAMBDA x, acc: acc \o <<x>>, <<>>, <<3, 1, 2>>))
ASSUME PrintT(FoldLeft(LAMBDA a, b: Append(a, b), <<>>, [i \in 1..3 |-> i * i]))
ASSUME PrintT(IsPrefix(<<1, 2>>, <<1, 2, 3>>))
ASSUME PrintT(IsPrefix(<<1, 3>>, <<1, 2, 3>>))
ASSUME PrintT(IsPrefix(<<>>, <<>>))
ASSUME PrintT(IsPrefix(<<1, 2, 3, 4>>, <<1, 2, 3>>))
ASSUME PrintT(IsPrefix("ab", "abc"))
ASSUME PrintT(IsPrefix("abd", "abc"))
ASSUME PrintT(SelectInSeq(<<1, 2, 3, 2>>, LAMBDA x: x = 2))
ASSUME PrintT(SelectLastInSeq(<<1, 2, 3, 2>>, LAMBDA x: x = 2))
ASSUME PrintT(SelectInSeq(<<>>, LAMBDA x: TRUE))
ASSUME PrintT(SelectInSubSeq(<<1, 2, 3, 2>>, 3, 4, LAMBDA x: x = 2))
ASSUME PrintT(SelectLastInSubSeq(<<1, 2, 3, 2>>, 1, 3, LAMBDA x: x = 2))
ASSUME PrintT(SelectInSubSeq(<<1, 2>>, 2, 1, LAMBDA x: TRUE))
ASSUME PrintT(RemoveFirst(<<1, 2, 1, 2>>, 2))
ASSUME PrintT(RemoveFirst(<<1>>, 3))
ASSUME PrintT(RemoveFirstMatch(<<1, 2, 3, 4>>, LAMBDA x: x > 1))
ASSUME PrintT(Suffixes(<<1, 2, 3>>))
ASSUME PrintT(Suffixes(<<>>))
ASSUME PrintT(AllSubSeqs(<<1, 2, 3>>))
ASSUME PrintT(AllSubSeqs(<<>>))
ASSUME PrintT(ReplaceFirstSubSeq("x", "ab", "cabab"))
ASSUME PrintT(ReplaceAllSubSeqs("x", "ab", "cabab"))
ASSUME PrintT(ReplaceAllSubSeqs("-", "", "abc"))
ASSUME PrintT(ReplaceFirstSubSeq("-", "", "abc"))
ASSUME PrintT(ReplaceFirstSubSeq(<<9>>, <<1>>, <<0, 1, 1>>))
ASSUME PrintT(ReplaceAllSubSeqs(<<9>>, <<1>>, <<0, 1, 1>>))
====
