---- MODULE EvSeq ----
EXTENDS Integers, Sequences, FiniteSets, TLC
ASSUME PrintT(Len(<<1, 2, 3>>))
ASSUME PrintT(Head(<<1, 2, 3>>))
ASSUME PrintT(Tail(<<1, 2, 3>>))
ASSUME PrintT(Append(<<1>>, 2))
ASSUME PrintT(<<1>> \o <<2, 3>>)
ASSUME PrintT(<<>> \o <<2, 3>>)
ASSUME PrintT(SubSeq(<<1, 2, 3, 4>>, 2, 3))
ASSUME PrintT(SubSeq(<<1, 2, 3>>, 3, 2))
ASSUME PrintT(SelectSeq(<<1, 2, 3, 4>>, LAMBDA x : x % 2 = 0))
ASSUME PrintT(Len("abc"))
ASSUME PrintT("ab" \o "cd")
ASSUME PrintT(SubSeq("hello", 2, 4))
ASSUME PrintT(Tail("abc"))
ASSUME PrintT(<<1, 2>> \in Seq({1, 2}))
ASSUME PrintT(<<1, 3>> \in Seq({1, 2}))
ASSUME PrintT(<<>> \in Seq({}))
ASSUME PrintT(Len(<<>>))
ASSUME PrintT(Append(<<>>, <<>>))
ASSUME PrintT(Len([i \in 1..4 |-> i]))
ASSUME PrintT(Head([i \in 1..4 |-> i * 3]))
ASSUME PrintT(Seq({1}) = Seq({1}))
ASSUME PrintT(SubSeq("hello", 3, 2))
ASSUME PrintT(Tail(<<1>>))
ASSUME PrintT(<<1, 2>> \o <<>>)
====
