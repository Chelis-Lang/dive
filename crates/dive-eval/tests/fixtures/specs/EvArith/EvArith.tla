---- MODULE EvArith ----
EXTENDS Integers, Sequences, FiniteSets, TLC
ASSUME PrintT(1 + 2)
ASSUME PrintT(2147483647 - 1)
ASSUME PrintT(7 \div 2)
ASSUME PrintT(-7 \div 2)
ASSUME PrintT(7 \div (-2))
ASSUME PrintT((-7) \div (-2))
ASSUME PrintT(-7 % 2)
ASSUME PrintT(7 % 3)
ASSUME PrintT(-1 % 5)
ASSUME PrintT(2 ^ 10)
ASSUME PrintT(0 ^ 5)
ASSUME PrintT(5 ^ 0)
ASSUME PrintT(-3 ^ 3)
ASSUME PrintT((-3) ^ 3)
ASSUME PrintT((-2) ^ 2)
ASSUME PrintT(1 < 2 /\ 2 <= 2 /\ 3 > 2 /\ 3 >= 3)
ASSUME PrintT(<<1 < 1, 1 <= 0, 0 > 1, 0 >= 1>>)
ASSUME PrintT(1..5)
ASSUME PrintT(5..1)
ASSUME PrintT(-2..2)
ASSUME PrintT(-(-5))
ASSUME PrintT(- 0)
ASSUME PrintT(Cardinality(1..10))
ASSUME PrintT(3 \in 1..5)
ASSUME PrintT(0 \in Nat)
ASSUME PrintT(-1 \in Nat)
ASSUME PrintT(-1 \in Int)
ASSUME PrintT(2147483647)
ASSUME PrintT(-2147483647 - 1)
ASSUME PrintT(3 * (-4))
ASSUME PrintT(10 - 20)
ASSUME PrintT(1..3 = {1, 2, 3})
ASSUME PrintT({1..3, {1, 2, 3}})
ASSUME PrintT(2..2)
ASSUME PrintT(Cardinality(5..1))
