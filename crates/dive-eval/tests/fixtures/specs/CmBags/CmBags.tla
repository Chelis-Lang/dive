---- MODULE CmBags ----
EXTENDS Integers, Sequences, FiniteSets, TLC, Bags, BagsExt
ASSUME PrintT(EmptyBag)
ASSUME PrintT(SetToBag({3, 1, 2}))
ASSUME PrintT(SetToBag({}))
ASSUME PrintT(IsABag(SetToBag({1})))
ASSUME PrintT(IsABag(<<1, 0>>))
ASSUME PrintT(IsABag(3))
ASSUME PrintT(IsABag([a |-> 2]))
ASSUME PrintT(BagToSet(SetToBag({"a", "b"})))
ASSUME PrintT(BagToSet(<<2, 3>>))
ASSUME PrintT(BagCardinality(<<2, 3>>))
ASSUME PrintT(BagCardinality(EmptyBag))
ASSUME PrintT(BagIn(1, <<1, 2>>))
ASSUME PrintT(BagIn(3, <<1, 2>>))
ASSUME PrintT(CopiesIn(2, <<1, 5>>))
ASSUME PrintT(CopiesIn(7, <<1, 5>>))
ASSUME PrintT((1 :> 2 @@ 2 :> 1) (+) (2 :> 3 @@ 4 :> 1))
ASSUME PrintT((1 :> 2 @@ 2 :> 1) (-) (1 :> 1 @@ 2 :> 5))
ASSUME PrintT((1 :> 2) \sqsubseteq (1 :> 3 @@ 2 :> 1))
ASSUME PrintT((1 :> 4) \sqsubseteq (1 :> 3))
ASSUME PrintT(BagUnion({(1 :> 1), (1 :> 2 @@ 3 :> 1)}))
ASSUME PrintT(BagUnion({}))
ASSUME PrintT(BagUnion({<<1>>}))
ASSUME PrintT(BagOfAll(LAMBDA x: x % 2, (1 :> 2 @@ 2 :> 1 @@ 3 :> 4)))
ASSUME PrintT(FoldBag(LAMBDA a, x: a + x, 0, (5 :> 3)))
ASSUME PrintT(FoldBag(LAMBDA a, x: a + x, 0, EmptyBag))
ASSUME PrintT(SubBag(1 :> 2))
====
