---- MODULE EvFcn ----
EXTENDS Integers, Sequences, FiniteSets, TLC
f == [x \in 1..3 |-> x * 2]
r == [a |-> 1, b |-> 2]
ASSUME PrintT(f)
ASSUME PrintT([x \in {"a", "b"} |-> 1])
ASSUME PrintT(f[2])
ASSUME PrintT(DOMAIN f)
ASSUME PrintT([f EXCEPT ![2] = 99])
ASSUME PrintT([r EXCEPT !.a = @ + 1])
ASSUME PrintT([r EXCEPT !.b = 5, !.a = 0])
ASSUME PrintT([[a |-> <<1, 2>>] EXCEPT !.a[2] = 7])
ASSUME PrintT([<<<<1, 2>>, <<3>>>> EXCEPT ![1][2] = @ * 10])
ASSUME PrintT(r.a)
ASSUME PrintT(r["b"])
ASSUME PrintT(<<1, 2, 3>>[2])
ASSUME PrintT(1 :> "a" @@ 2 :> "b")
ASSUME PrintT((1 :> "a") @@ (1 :> "b"))
ASSUME PrintT([x \in {1, 2}, y \in {3} |-> x + y])
ASSUME PrintT(DOMAIN [x \in {1, 2}, y \in {3} |-> x + y])
ASSUME PrintT([x \in {1, 2}, y \in {3} |-> x + y][2, 3])
ASSUME PrintT([<<x, y>> \in {1} \X {2} |-> x + y])
ASSUME PrintT([n \in Nat |-> n * 2][21])
ASSUME PrintT(DOMAIN <<>>)
ASSUME PrintT(<<>>)
ASSUME PrintT([a |-> 1] = [a |-> 1])
ASSUME PrintT(DOMAIN r)
ASSUME PrintT([x \in {} |-> 1])
ASSUME PrintT([f EXCEPT ![1] = 0, ![1] = @ + 5])
ASSUME PrintT([x \in 2..4 |-> x][3])
ASSUME PrintT([x \in 2..4 |-> x])
ASSUME PrintT(f = <<2, 4, 6>>)
ASSUME PrintT(<<1, 2>> = [i \in 1..2 |-> i])
ASSUME PrintT([i \in 1..2 |-> i] = (1 :> 1 @@ 2 :> 2))
ASSUME PrintT([n \in Nat |-> n + 1][0] = 1)
ASSUME PrintT(LET g == [n \in Nat |-> n] IN g[7])
ASSUME PrintT(LET g == [n \in Nat |-> n] IN [g EXCEPT ![3] = 9][3])
ASSUME PrintT(LET g == [n \in Nat |-> n] IN [g EXCEPT ![3] = 9][4])
ASSUME PrintT(DOMAIN [n \in Nat |-> n] = Nat)
ASSUME PrintT([[x \in 1..2 |-> [y \in 1..2 |-> x * y]] EXCEPT ![2][2] = 0])
ASSUME PrintT([x \in {"a", "b"} |-> x] = [a |-> "a", b |-> "b"])
====
