#!/bin/zsh
# vol <node-name> [modify]: raise the node's root volume to 16000 IOPS / 1000 MiB/s
# (with `modify`) and show the modification state. Same environment as `n`.
: ${DIVE_PERF_STATE:?set DIVE_PERF_STATE}
: ${AWS_PROFILE:?set AWS_PROFILE}
export AWS_REGION=${AWS_REGION:-us-east-1} AWS_PAGER=""
source $DIVE_PERF_STATE
I=${(P)1}
V=$(aws ec2 describe-instances --instance-ids $I --query 'Reservations[0].Instances[0].BlockDeviceMappings[0].Ebs.VolumeId' --output text 2>/dev/null)
[ "$2" = modify ] && aws ec2 modify-volume --volume-id $V --iops 16000 --throughput 1000 >/dev/null 2>&1
aws ec2 describe-volumes-modifications --volume-ids $V --query 'VolumesModifications[0].[ModificationState,TargetIops,TargetThroughput]' --output text 2>/dev/null
