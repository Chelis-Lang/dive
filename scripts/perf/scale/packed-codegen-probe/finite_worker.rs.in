// Generated by emit_finite_search.py from the bound finite relation.
// The experiment supports completed holding searches and returns no proof on
// other endings. It is independent of the production checker entry point.
use std::collections::HashSet;
use std::hash::{BuildHasherDefault, Hasher};
use std::time::Instant;

#[derive(Default)]
struct RankHash(u64);

impl Hasher for RankHash {
    fn write(&mut self, _: &[u8]) {
        unreachable!("only packed u64 keys are hashed");
    }

    fn write_u64(&mut self, rank: u64) {
        let product = rank.wrapping_mul(0xa076_1d64_78bd_642f);
        self.0 = product ^ product.rotate_left(23);
    }

    fn finish(&self) -> u64 {
        self.0
    }
}

type Page = HashSet<u64, BuildHasherDefault<RankHash>>;

struct Membership {
    dense: Vec<u64>,
    sparse: Vec<Page>,
}

impl Membership {
    fn new(width: u32) -> Self {
        if width <= 32 {
            Self { dense: vec![0; (1_usize << width).div_ceil(64)], sparse: Vec::new() }
        } else {
            Self { dense: Vec::new(), sparse: (0..256).map(|_| Page::default()).collect() }
        }
    }

    fn insert(&mut self, key: u64) -> bool {
        if !self.dense.is_empty() {
            let word = &mut self.dense[key as usize / 64];
            let mask = 1_u64 << (key % 64);
            let fresh = *word & mask == 0;
            *word |= mask;
            return fresh;
        }
        let mixed = key.wrapping_mul(0xe703_7ed1_a0b4_28db);
        self.sparse[(mixed >> 56) as usize].insert(key)
    }
}

const WIDTH: u32 = @WIDTH@;
const FIXED: u32 = @FIXED@;
const ROLES: usize = @ROLES@;
const LANE: u32 = @LANE@;
const CHECK_DEADLOCK: bool = @CHECK_DEADLOCK@;

struct Search {
    seen: Membership,
    next: Vec<u64>,
    generated: u64,
    distinct: u64,
    failed: bool,
}

impl Search {
    fn identity(row: u64) -> u64 {
        if ROLES < 2 {
            return row;
        }
        let mut lanes = [0; ROLES];
        let mask = (1 << LANE) - 1;
        for (index, lane) in lanes.iter_mut().enumerate() {
            *lane = row >> (FIXED + LANE * index as u32) & mask;
        }
        lanes.sort_unstable_by(|a, b| b.cmp(a));
        let mut key = row & (u64::MAX.checked_shr(64 - FIXED).unwrap_or(0));
        for (index, lane) in lanes.into_iter().enumerate() {
            key |= lane << (FIXED + LANE * index as u32);
        }
        key
    }

    fn emit(&mut self, row: u64) {
        self.generated += 1;
        let key = Self::identity(row);
        if !self.seen.insert(key) {
            return;
        }
        self.failed |= !(@PROPERTIES@);
        self.distinct += 1;
        self.next.push(row);
    }

    fn expand(&mut self, row: u64) {
        let before = self.generated;
        @EXPAND@
        self.failed |= CHECK_DEADLOCK && before == self.generated;
    }
}

fn main() -> std::process::ExitCode {
    let start = Instant::now();
    let mut search = Search {
        seen: Membership::new(WIDTH),
        next: Vec::new(),
        generated: 0,
        distinct: 0,
        failed: false,
    };
    for word in [@INITIALS@] {
        search.emit(word);
    }
    search.generated = @INITIAL_GENERATED@;
    let mut frontier = Vec::new();
    let mut depth = 0;
    while !search.next.is_empty() {
        if search.failed {
            break;
        }
        depth += 1;
        std::mem::swap(&mut frontier, &mut search.next);
        for &row in &frontier {
            search.expand(row);
        }
        frontier.clear();
    }
    if search.failed {
        eprintln!("The generated search found a nonholding invariant or deadlock. Run Core for a witness.");
        return std::process::ExitCode::from(2);
    }
    let elapsed_ns = start.elapsed().as_nanos();
    println!("{{\"elapsed_ns\":{elapsed_ns},\"generated\":{},\"distinct\":{},\"depth\":{depth}}}",
             search.generated, search.distinct);
    std::process::ExitCode::SUCCESS
}
