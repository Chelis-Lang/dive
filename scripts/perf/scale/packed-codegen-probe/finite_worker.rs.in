// Generated by emit_finite_search.py from the bound finite relation.
// The experiment supports completed holding searches and returns no proof on
// other endings. It is independent of the production checker entry point.
use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
use std::time::Instant;

const FIXED: u32 = @FIXED@;
const ROLES: usize = @ROLES@;
const LANE: u32 = @LANE@;
const CHECK_DEADLOCK: bool = @CHECK_DEADLOCK@;
const INVALID: u16 = u16::MAX;
const FIXED_TABLE: [u16; 1 << FIXED] = [@FIXED_RANKS@];
const LANE_TABLE: [u16; 1 << LANE] = [@LANE_RANKS@];
const LANES: usize = @LANE_RANGE@;
const FIXED_SPACE: usize = @FIXED_SPACE@;
const MEMBERSHIP_BITS: usize = @MEMBERSHIP_BITS@;

const fn choose(n: usize, k: usize) -> usize {
    if k > n {
        return 0;
    }
    let mut result = 1;
    let mut index = 0;
    while index < k {
        result = result * (n - index) / (index + 1);
        index += 1;
    }
    result
}

const ROWS: [[usize; LANES]; ROLES] = {
    let mut ranks = [[0; LANES]; ROLES];
    let mut index = 0;
    while index < ROLES {
        let mut lane = 0;
        while lane < LANES {
            ranks[index][lane] = choose(lane + index, index + 1);
            lane += 1;
        }
        index += 1;
    }
    ranks
};

struct Search<'a> {
    seen: &'a [AtomicU64],
    next: Vec<u64>,
    generated: u64,
    distinct: u64,
    failed: bool,
}

impl Search<'_> {
    fn identity(row: u64) -> Option<(u64, usize)> {
        let mut lanes = [0; ROLES];
        let mask = (1 << LANE) - 1;
        for (index, lane) in lanes.iter_mut().enumerate() {
            *lane = row >> (FIXED + LANE * index as u32) & mask;
        }
        lanes.sort_unstable();
        let mut key = row & ((1_u64 << FIXED) - 1);
        let fixed = FIXED_TABLE[key as usize];
        if fixed == INVALID {
            return None;
        }
        let mut orbit = 0;
        for (index, lane) in lanes.into_iter().enumerate() {
            let rank = LANE_TABLE[lane as usize];
            if rank == INVALID {
                return None;
            }
            orbit += ROWS[index][usize::from(rank)];
            key |= lane << (FIXED + LANE * index as u32);
        }
        Some((key, orbit * FIXED_SPACE + usize::from(fixed)))
    }

    fn emit(&mut self, row: u64) {
        self.generated += 1;
        let Some((key, rank)) = Self::identity(row) else {
            self.failed = true;
            return;
        };
        let word = &self.seen[rank / 64];
        let bit = 1_u64 << (rank % 64);
        if word.load(Relaxed) & bit != 0 || word.fetch_or(bit, Relaxed) & bit != 0 {
            return;
        }
        self.failed |= !(@PROPERTIES@);
        self.distinct += 1;
        self.next.push(key);
    }

    fn expand(&mut self, row: u64) {
        let before = self.generated;
        @EXPAND@
        self.failed |= CHECK_DEADLOCK && before == self.generated;
    }
}

#[derive(Default)]
struct Totals {
    generated: u64,
    distinct: u64,
    failed: bool,
}

fn pool_wave<'a>(chunk: &[u64], seen: &'a [AtomicU64]) -> Search<'a> {
    let mut worker = Search {
        seen,
        generated: 0,
        distinct: 0,
        failed: false,
        next: Vec::with_capacity(chunk.len()),
    };
    for &row in chunk {
        worker.expand(row);
    }
    worker
}

fn account(totals: &mut Totals, next: &mut Vec<u64>, mut worker: Search<'_>) {
    totals.generated += worker.generated;
    totals.distinct += worker.distinct;
    totals.failed |= worker.failed;
    if next.is_empty() {
        *next = worker.next;
    } else {
        next.append(&mut worker.next);
    }
}

fn main() -> std::process::ExitCode {
    let workers = match std::env::args().nth(1) {
        Some(width) => match width.parse::<usize>() {
            Ok(n @ 1..=32) => n,
            _ => return std::process::ExitCode::from(2),
        },
        None => 1,
    };
    let progress = std::env::var_os("DIVE_ORBIT_PROGRESS").is_some();
    let start = Instant::now();
    let mut seen = Vec::new();
    seen.resize_with(MEMBERSHIP_BITS.div_ceil(64), || AtomicU64::new(0));
    let mut search = pool_wave(&[], &seen);
    for word in [@INITIALS@] {
        search.emit(word);
    }
    search.generated = @INITIAL_GENERATED@;
    let mut totals = Totals::default();
    let mut next = Vec::new();
    account(&mut totals, &mut next, search);
    let mut frontier = Vec::new();
    let mut depth = 0;
    while !next.is_empty() && !totals.failed {
        depth += 1;
        std::mem::swap(&mut frontier, &mut next);
        if workers == 1 || frontier.len() <= 4096 {
            account(&mut totals, &mut next, pool_wave(&frontier, &seen));
        } else {
            std::thread::scope(|scope| {
                let handles: Vec<_> = frontier.chunks(frontier.len().div_ceil(workers))
                    .map(|chunk| {
                        let seen = &seen;
                        scope.spawn(move || pool_wave(chunk, seen))
                    }).collect();
                for handle in handles {
                    account(&mut totals, &mut next, handle.join().expect("the search worker completed"));
                }
            });
        }
        frontier.clear();
        if progress {
            eprintln!("{{\"wave\":{depth},\"generated\":{},\"distinct\":{},\"queued\":{}}}",
                      totals.generated, totals.distinct, next.len());
        }
    }
    if totals.failed {
        eprintln!("The generated search found a nonholding invariant or deadlock. Run Core for a witness.");
        return std::process::ExitCode::from(2);
    }
    let elapsed_ns = start.elapsed().as_nanos();
    println!("{{\"elapsed_ns\":{elapsed_ns},\"generated\":{},\"distinct\":{},\"depth\":{depth},\"workers\":{workers}}}",
             totals.generated, totals.distinct);
    std::process::ExitCode::SUCCESS
}
