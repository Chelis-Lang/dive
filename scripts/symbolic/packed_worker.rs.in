// The binder has established that each complete transition stays in this layout.
#![forbid(unsafe_code)]

use std::process::ExitCode;
use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
use std::thread;

type Row = @WORD@;
const RANKED: bool = @RANKED@;
const FIXED: u32 = @FIXED@;
const ROLES: usize = @ROLES@;
const LANE: u32 = @LANE@;
const CHECK_DEADLOCK: bool = @CHECK_DEADLOCK@;
const INITIAL_GENERATED: u64 = @INITIAL_GENERATED@;
const INITIALS: &[Row] = &[@INITIALS@];
const MEMBERSHIP_BITS: usize = @MEMBERSHIP_BITS@;
const INVALID: u16 = u16::MAX;
const FIXED_SPACE: usize = @FIXED_SPACE@;
const LANE_RANGE: usize = @LANE_RANGE@;
const FIXED_RANKS: [u16; if RANKED { 1 << FIXED } else { 0 }] = [@FIXED_RANKS@];
const LANE_RANKS: [u16; if RANKED { 1 << LANE } else { 0 }] = [@LANE_RANKS@];

// For sorted lane ordinals r[i], the integers r[i] + i form a strict
// combination. Its colexicographic rank is sum(C(r[i] + i, i + 1)).
const COLEX: [[usize; LANE_RANGE]; ROLES] = {
    let mut ranks = [[0; LANE_RANGE]; ROLES];
    let mut index = 0;
    while index < ROLES {
        let mut lane = 0;
        while lane < LANE_RANGE {
            let mut rank = 1;
            let mut k = 0;
            while k <= index {
                rank = rank * (lane + index - k) / (k + 1);
                k += 1;
            }
            ranks[index][lane] = rank;
            lane += 1;
        }
        index += 1;
    }
    ranks
};

fn identity(row: Row) -> Option<(Row, usize)> {
    if ROLES < 2 {
        return Some((row, row as usize));
    }
    let mask = (1 << LANE) - 1;
    let mut lanes = [0; ROLES];
    for (index, lane) in lanes.iter_mut().enumerate() {
        *lane = row >> (FIXED + LANE * index as u32) & mask;
    }
    lanes.sort_unstable();
    let mut key = row & Row::MAX.checked_shr(Row::BITS - FIXED).unwrap_or(0);
    let fixed = if RANKED {
        let fixed = FIXED_RANKS[key as usize];
        if fixed == INVALID {
            return None;
        }
        usize::from(fixed)
    } else {
        0
    };
    let mut orbit = 0;
    for (index, lane) in lanes.into_iter().enumerate() {
        if RANKED {
            let ordinal = LANE_RANKS[lane as usize];
            if ordinal == INVALID {
                return None;
            }
            orbit += COLEX[index][usize::from(ordinal)];
        }
        key |= lane << (FIXED + LANE * index as u32);
    }
    let rank = if RANKED { orbit * FIXED_SPACE + fixed } else { key as usize };
    Some((key, rank))
}

#[inline]
fn failed_property(row: Row) -> Option<usize> {
    @PROPERTIES@
    None
}

#[inline]
fn successors(row: Row, mut emit: impl FnMut(Row)) {
    @EXPAND@
}

#[inline]
fn mark(seen: &[AtomicU64], rank: usize) -> bool {
    let word = &seen[rank / 64];
    let mask = 1_u64 << (rank % 64);
    word.load(Relaxed) & mask == 0 && word.fetch_or(mask, Relaxed) & mask == 0
}

fn found(left: Option<usize>, right: Option<usize>) -> Option<usize> {
    match (left, right) {
        (Some(a), Some(b)) if a != b => Some(usize::MAX),
        _ => left.or(right),
    }
}

struct Search<'a> {
    seen: &'a [AtomicU64],
    next: Vec<Row>,
    generated: u64,
    invariant: Option<usize>,
    deadlock: bool,
    rank_error: bool,
}

impl Search<'_> {
    #[inline]
    fn emit(&mut self, row: Row) {
        self.generated += 1;
        let Some((key, rank)) = identity(row) else {
            // Projections cover every state satisfying all configured
            // invariants. A missing rank can still be a real finding.
            let failure = failed_property(row);
            self.invariant = found(self.invariant, failure);
            self.rank_error |= failure.is_none();
            return;
        };
        if !mark(self.seen, rank) {
            return;
        }
        if let Some(property) = failed_property(row) {
            self.invariant = found(self.invariant, Some(property));
        }
        self.next.push(key);
    }

    fn expand(&mut self, row: Row) {
        let before = self.generated;
        successors(row, |row| self.emit(row));
        self.deadlock |= CHECK_DEADLOCK && self.generated == before;
    }

    fn absorb(&mut self, mut other: Self) {
        self.generated += other.generated;
        self.invariant = found(self.invariant, other.invariant);
        self.deadlock |= other.deadlock;
        self.rank_error |= other.rank_error;
        if self.next.is_empty() {
            self.next = other.next;
        } else {
            self.next.append(&mut other.next);
        }
    }
}

fn expand<'a>(seen: &'a [AtomicU64], rows: &[Row], next: Vec<Row>) -> Search<'a> {
    let mut search = Search { seen, next, generated: 0, invariant: None, deadlock: false, rank_error: false };
    for &row in rows {
        search.expand(row);
    }
    search
}

fn finding(property: Option<usize>, invariant_depth: u32, deadlock: bool, deadlock_depth: u32) {
    let invariant = if property.is_some() { invariant_depth } else { 0 };
    let deadlock = if deadlock { deadlock_depth } else { 0 };
    let property = property.filter(|p| *p != usize::MAX).map_or("null".to_owned(), |p| p.to_string());
    println!("{{\"invariant_depth\":{invariant},\"deadlock_depth\":{deadlock},\"property_index\":{property}}}");
}

fn rank_error() -> ExitCode {
    eprintln!("Error: compiled orbit rank is missing for a state satisfying all invariants");
    ExitCode::from(6)
}

fn new_seen() -> Option<Vec<AtomicU64>> {
    let bitset_words = MEMBERSHIP_BITS.div_ceil(64);
    let mut seen = Vec::new();
    seen.try_reserve_exact(bitset_words).ok()?;
    seen.resize_with(bitset_words, || AtomicU64::new(0));
    Some(seen)
}

fn search(workers: usize) -> ExitCode {
    let Some(seen) = new_seen() else {
        return ExitCode::from(4);
    };
    let mut wave = expand(&seen, &[], Vec::new());
    for &row in INITIALS {
        wave.emit(row);
    }
    if wave.rank_error {
        return rank_error();
    }
    if wave.invariant.is_some() {
        finding(wave.invariant, 1, false, 0);
        return ExitCode::from(5);
    }
    let mut current = wave.next;
    let mut generated = INITIAL_GENERATED;
    let mut distinct = current.len();
    let mut spare = Vec::new();
    let mut depth = 0;
    let mut used = 1;
    while !current.is_empty() {
        depth += 1;
        let width = if current.len() > 4096 { workers } else { 1 };
        if width == 1 {
            wave = expand(&seen, &current, spare);
        } else {
            let rows = current.chunks(current.len().div_ceil(width));
            used = used.max(rows.len());
            let seen = &seen;
            wave = thread::scope(|scope| {
                let mut rows = rows;
                let first = rows.next().unwrap_or(&[]);
                let handles: Vec<_> = rows.map(|chunk| scope.spawn(move || expand(seen, chunk, Vec::new()))).collect();
                let mut combined = expand(seen, first, spare);
                for handle in handles {
                    match handle.join() {
                        Ok(worker) => combined.absorb(worker),
                        Err(error) => std::panic::resume_unwind(error),
                    }
                }
                combined
            });
        }
        if wave.rank_error {
            return rank_error();
        }
        if wave.invariant.is_some() || wave.deadlock {
            finding(wave.invariant, depth + 1, wave.deadlock, depth);
            return ExitCode::from(5);
        }
        generated += wave.generated;
        distinct += wave.next.len();
        current.clear();
        spare = current;
        current = wave.next;
    }
    println!("{{\"generated\":{generated},\"distinct\":{distinct},\"depth\":{depth},\"initial_generated\":{INITIAL_GENERATED},\"workers_used\":{used}}}");
    ExitCode::SUCCESS
}

// The first pass proves the finding layer without storing predecessors. On
// demand, visit each orbit again but expand the concrete row that discovered
// it. The rank is used only for membership. Each predecessor edge is then an
// actual transition of the encoded model, even under symmetry.
fn witness(depth: usize, property: usize) -> ExitCode {
    // Replay is serial. A zeroed integer bitmap can use demand-zero pages
    // and needs no atomic admissions while retaining the same exact ranks.
    let mut seen = vec![0_u64; MEMBERSHIP_BITS.div_ceil(64)];
    let mut nodes: Vec<(Row, usize)> = Vec::new();
    let root = usize::MAX;
    let mut start = 0;
    let mut end = 0;
    for layer in 1..=depth {
        let mut terminal = None;
        let mut bad_rank = false;
        let mut visit = |nodes: &mut Vec<_>, row, parent| {
            if layer == depth {
                if terminal.is_none() && failed_property(row) == Some(property) {
                    terminal = Some((row, parent));
                }
            } else if let Some((_, rank)) = identity(row) {
                let word = &mut seen[rank / 64];
                let mask = 1_u64 << (rank % 64);
                if *word & mask == 0 {
                    *word |= mask;
                    nodes.push((row, parent));
                }
            } else {
                bad_rank = true;
            }
            terminal.is_some()
        };
        if layer == 1 {
            for &row in INITIALS {
                visit(&mut nodes, row, root);
            }
        } else {
            for parent in start..end {
                let row = nodes[parent].0;
                let mut finished = false;
                successors(row, |row| finished |= visit(&mut nodes, row, parent));
                if finished {
                    break;
                }
            }
        }
        if bad_rank {
            return rank_error();
        }
        if let Some((row, mut parent)) = terminal {
            let mut rows = vec![row];
            while parent != root {
                let (row, predecessor) = nodes[parent];
                rows.push(row);
                parent = predecessor;
            }
            rows.reverse();
            println!("{{\"rows\":{rows:?}}}");
            return ExitCode::SUCCESS;
        }
        start = end;
        end = nodes.len();
    }
    eprintln!("Error: compiled witness search did not reproduce its finding layer");
    ExitCode::from(7)
}

fn main() -> ExitCode {
    let args: Vec<_> = std::env::args().skip(1).collect();
    match args.as_slice() {
        [workers] => match workers.parse() {
            Ok(workers @ 1..=8) => search(workers),
            _ => ExitCode::from(3),
        },
        [mode, depth, property] if mode == "witness" => match (depth.parse(), property.parse()) {
            (Ok(depth @ 1..), Ok(property)) => witness(depth, property),
            _ => ExitCode::from(3),
        },
        _ => ExitCode::from(3),
    }
}
